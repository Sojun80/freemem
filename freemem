#!/bin/sh
# freemem - one-shot RAM, process, and NVIDIA VRAM summary for Linux.
# POSIX sh; only /proc, ps, awk, sort, head, and nvidia-smi are used.

LC_ALL=C
export LC_ALL

if [ -t 1 ] 2>/dev/null; then
    freemem_teal=$(printf '\033[36m')
    freemem_green=$(printf '\033[32m')
    freemem_red=$(printf '\033[31m')
    freemem_reset=$(printf '\033[0m')
else
    freemem_teal=''
    freemem_green=''
    freemem_red=''
    freemem_reset=''
fi

human_kib() {
    awk -v n="${1:-0}" 'BEGIN {
        if (n >= 1073741824) printf "%.2f TiB", n / 1073741824
        else if (n >= 1048576) printf "%.2f GiB", n / 1048576
        else if (n >= 1024) printf "%.1f MiB", n / 1024
        else printf "%.0f KiB", n
    }'
}

print_ram() {
    if [ ! -r /proc/meminfo ]; then
        printf '%s\n' 'RAM: /proc/meminfo is unavailable.'
        return
    fi

    mem_values=$(awk '
        /^MemTotal:/     { total = $2 }
        /^MemAvailable:/ { available = $2 }
        /^MemFree:/      { free = $2 }
        /^Buffers:/      { buffers = $2 }
        /^Cached:/       { cached = $2 }
        /^SReclaimable:/ { reclaimable = $2 }
        /^Shmem:/        { shmem = $2 }
        END {
            if (!total) exit 1
            if (!available) {
                available = free + buffers + cached + reclaimable - shmem
            }
            if (available < 0) available = 0
            if (available > total) available = total
            printf "%d %d %d\n", total, total - available, available
        }
    ' /proc/meminfo 2>/dev/null)

    if [ -z "$mem_values" ]; then
        printf '%s\n' 'RAM: Could not read memory totals.'
        return
    fi

    set -- $mem_values
    if [ "$(awk -v available="$3" -v total="$1" 'BEGIN { print (total > 0 && available / total < 0.10) ? "red" : "green" }')" = red ]; then
        available_color=$freemem_red
    else
        available_color=$freemem_green
    fi

    printf '%sRAM:%s Total %s | Used %s | %sAvailable %s%s\n' \
        "$freemem_teal" "$freemem_reset" "$(human_kib "$1")" \
        "$(human_kib "$2")" "$available_color" "$(human_kib "$3")" \
        "$freemem_reset"
}

print_top_processes() {
    if [ "$freemem_cpu_label" = all ]; then
        freemem_cpu_heading='All processes by RSS'
    else
        freemem_cpu_heading="Top $freemem_cpu_label processes by RSS"
    fi
    printf '\n%s%s%s\n' "$freemem_teal" "$freemem_cpu_heading" "$freemem_reset"
    printf '%s%-8s %-16s %11s  %s%s\n' "$freemem_teal" 'PID' 'USER' 'RSS' 'COMMAND' "$freemem_reset"

    if ! command -v ps >/dev/null 2>&1; then
        printf '%s\n' 'ps is unavailable.'
        return
    fi

    if [ -n "$freemem_cpu_limit" ]; then
        ps -eo pid=,user=,rss=,args= 2>/dev/null |
            sort -k3,3nr |
            head -n "$freemem_cpu_limit"
    else
        ps -eo pid=,user=,rss=,args= 2>/dev/null |
            sort -k3,3nr
    fi |
        awk '
            function human(k) {
                if (k >= 1048576) return sprintf("%.2f GiB", k / 1048576)
                if (k >= 1024) return sprintf("%.1f MiB", k / 1024)
                return sprintf("%.0f KiB", k)
            }
            NF >= 4 {
                pid = $1
                user = $2
                rss = $3 + 0
                $1 = ""; $2 = ""; $3 = ""
                sub(/^[[:space:]]+/, "", $0)
                command = $0
                if (length(command) > 112) command = substr(command, 1, 109) "..."
                printf "%-8s %-16s %11s  %s\n", pid, user, human(rss), command
            }
        '
}

print_nvidia() {
    if [ "$freemem_gpu_label" = all ]; then
        freemem_gpu_heading='GPU VRAM (NVIDIA; all processes per GPU)'
    else
        freemem_gpu_heading="GPU VRAM (NVIDIA; top $freemem_gpu_label processes per GPU)"
    fi
    printf '\n%s%s%s\n' "$freemem_teal" "$freemem_gpu_heading" "$freemem_reset"

    if ! command -v nvidia-smi >/dev/null 2>&1; then
        printf '%s\n' '  nvidia-smi is unavailable; GPU VRAM per-process data was not found.'
        return
    fi

    gpu_totals=$(nvidia-smi \
        --query-gpu=index,name,memory.used,memory.total \
        --format=csv,noheader,nounits 2>/dev/null)

    if [ -n "$gpu_totals" ]; then
        printf '%s\n' "$gpu_totals" |
            awk -F ',[[:space:]]*' \
                -v green="$freemem_green" -v red="$freemem_red" -v reset="$freemem_reset" '
                function human(m) {
                    if (m >= 1048576) return sprintf("%.2f TiB", m / 1048576)
                    if (m >= 1024) return sprintf("%.2f GiB", m / 1024)
                    return sprintf("%.0f MiB", m)
                }
                NF >= 4 {
                    used = $3 + 0
                    total = $4 + 0
                    available = total - used
                    color = green
                    # Red below 2 GiB free, or below 10% free on larger cards.
                    if (available < 2048 || (total > 0 && available / total < 0.10)) color = red
                    printf "  GPU %-2s %-30s %s / %s | %s%s free%s\n", \
                        $1, $2, human(used), human(total), color, human(available), reset
                }
            '
    else
        printf '%s\n' '  Could not read GPU totals from nvidia-smi.'
    fi

    report=$(nvidia-smi 2>/dev/null)
    process_rows=$(printf '%s\n' "$report" |
        awk '
            function to_mib(v) {
                gsub(/[[:space:]]/, "", v)
                if (v ~ /TiB$/) { sub(/TiB$/, "", v); return v * 1048576 }
                if (v ~ /GiB$/) { sub(/GiB$/, "", v); return v * 1024 }
                if (v ~ /MiB$/) { sub(/MiB$/, "", v); return v + 0 }
                if (v ~ /KiB$/) { sub(/KiB$/, "", v); return v / 1024 }
                return 0
            }
            function trim(s) {
                sub(/^[[:space:]]+/, "", s)
                sub(/[[:space:]]+$/, "", s)
                return s
            }
            {
                type_index = 0
                memory_index = 0
                for (i = 2; i <= NF; i++) {
                    if ($i == "C" || $i == "G") type_index = i
                    if ($i ~ /^[0-9]+([.][0-9]+)?(KiB|MiB|GiB|TiB)$/) memory_index = i
                }
                if (!type_index || memory_index <= type_index) next

                gpu = ""
                for (i = 2; i < type_index; i++) {
                    if ($i ~ /^[0-9]+$/) { gpu = $i; break }
                }
                pid = $(type_index - 1)
                if (pid !~ /^[0-9]+$/) {
                    for (i = type_index - 1; i >= 2; i--) {
                        if ($i ~ /^[0-9]+$/) { pid = $i; break }
                    }
                }

                name = ""
                for (i = type_index + 1; i < memory_index; i++) {
                    name = name (name ? " " : "") $i
                }
                name = trim(name)
                if (gpu != "" && pid ~ /^[0-9]+$/ && name != "") {
                    printf "%.3f\t%s\t%s\t%s\t%s\n", to_mib($(memory_index)), gpu, pid, $type_index, name
                }
            }
        ' |
        sort -k2,2n -k1,1nr)

    if [ -z "$process_rows" ]; then
        printf '%s\n' '  No GPU processes reported.'
        return
    fi

    printf '%s%-5s %-8s %-4s %11s  %s%s\n' "$freemem_teal" 'GPU' 'PID' 'TYPE' 'VRAM' 'PROCESS' "$freemem_reset"
    printf '%s\n' "$process_rows" |
        awk -F '\t' -v limit="$freemem_gpu_limit" '
            function human(m) {
                if (m >= 1048576) return sprintf("%.2f TiB", m / 1048576)
                if (m >= 1024) return sprintf("%.2f GiB", m / 1024)
                return sprintf("%.0f MiB", m)
            }
            {
                if (limit == "" || ++seen[$2] <= limit) {
                    printf "%-5s %-8s %-4s %11s  %s\n", $2, $3, $4, human($1), $5
                }
            }
        '
}

freemem_cpu_limit=15
freemem_gpu_limit=2
freemem_cpu_label=15
freemem_gpu_label=2

case "${1:-}" in
    -h|--help)
        printf '%s\n' "Usage: ${0##*/} [COUNT|all]" '' \
            'Print RAM, the top RSS processes, and NVIDIA VRAM users per GPU.' '' \
            'No argument: top 15 RSS processes and top 2 GPU users per GPU.' \
            'COUNT: use that number for both lists. all: show every item.'
        exit 0
        ;;
    '') ;;
    all)
        freemem_cpu_limit=''
        freemem_gpu_limit=''
        freemem_cpu_label=all
        freemem_gpu_label=all
        ;;
    0|*[!0-9]*)
        printf 'Usage: %s [COUNT|all]\n' "${0##*/}" >&2
        exit 2
        ;;
    *)
        freemem_cpu_limit=$1
        freemem_gpu_limit=$1
        freemem_cpu_label=$1
        freemem_gpu_label=$1
        ;;
esac

print_ram
print_top_processes
print_nvidia
