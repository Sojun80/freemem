    ui_pad "MEM ${mclk} MHz" 16; content+=$UI_PADDED
    ui_pad "TEMP ${ftemp}°C" 15; content+=$UI_PADDED
    ui_pad "POWER ${fdraw} W" 17; content+=$UI_PADDED
    content+="FAN ${fan}%"
    ui_line "$content" "$green"
    fmt_memory "${gpu_memory_used[$selected]-N/A}" "${gpu_memory_total[$selected]-N/A}" >/dev/null
    fmem=${FMT%% (*}
    printf -v content '  P-STATE %-8s  POWER LIMIT %-8s  VRAM %s' "${gpu_pstate[$selected]-N/A}" "$flim W" "$fmem"
    ui_line "$content"

    ui_rule '╠' '═' '╣' 'TUNING MATRIX'
    ui_line '    CONTROL           CURRENT      TARGET        HARDWARE RANGE' "$bold$cyan"
    ui_rule '╟' '─' '╢'
    caps_for_index "$selected"
    for index in 0 1 2 3 4 5; do ui_control_row "$selected" "$index"; done
    ui_line '  C = CURRENT     T = TARGET     S = STOCK     ◎ = MATCH     ◈ = MODIFIED' "$dim"

    ui_rule '╠' '═' '╣' 'PRECISION INPUT'
    if (( numeric_entry )); then
        label=$(ui_control_label "$selected_field")
        value="${numeric_buffer}█"
        precision='ENTER confirm     ESC cancel     ←/→ fine adjust'
    elif [[ $screen == settings ]]; then
        if (( selected_field <= 5 )); then
            label=$(ui_control_label "$selected_field")
            field_target_display "$selected" "$selected_field" >/dev/null; value=$FTD
            precision='ENTER edit exact target     ←/→ adjust     ESC back'
        else
            label='CONTROL DECK'; value='F5 Apply  /  F6 Reset'
            precision='F5 apply staged values     F6 stage stock targets'
        fi
    else
        label='READ ONLY'; value='Select a GPU, then press ENTER to edit'
        precision='↑/↓ choose GPU     ENTER lock selection     TAB next GPU'
    fi
    ui_line "    ${label}" "$bold$yellow"
    ui_card_border top
    ui_card_line "${value}" "$yellow"
    ui_card_border bottom
    ui_line "    ${precision}" "$dim"

    ui_rule '╠' '═' '╣' 'CONTROL DECK'
    ui_line '    [ F5 APPLY ]      [ F6 RESET ]      [ F7 SAVE ]      [ F8 LOAD ]' "$bold$yellow"
    ui_line '    ↑↓ SELECT      ←→ ADJUST      ENTER EDIT      TAB GPU      ? HELP' "$cyan"
    if [[ -n $notice ]]; then ui_line "  ${notice}" "$notice_color"; else ui_line '  Ready.' "$dim"; fi
    pending_count "$selected" >/dev/null; count=$PC
    printf -v content '  ◈ %02d PENDING CHANGE(S)       ● GPU CONNECTED       SIMULATION: WRITES DISABLED' "$count"
    ui_line "$content" "$bold$green"
    ui_rule '╚' '═' '╝'
}

render_frame() {
    if (( TERM_W >= 88 && TERM_H >= 41 + ${#gpu_indices[@]} )); then
        render_console_frame
    else
        render_compact_frame
    fi
}

draw() {
    local frame drawn_frame
    # Build the complete frame before moving the cursor. Overwrite each line
    # in place and clear only the area below it; clearing the whole screen is
    # what causes the visible blink during refreshes.
    frame=$(render_frame)
    drawn_frame=${frame//$'\n'/$'\n\033[2K'}
    printf '\033[H\033[2K%s\033[J' "$drawn_frame"
}

