usage() {
    cat <<EOF
Usage: ${0##*/} [OPTIONS]

Keyboard-driven NVIDIA GPU overclocking prototype.

Options:
  -r, --refresh SEC   Telemetry refresh interval (default: 1)
      --dry-run       Preview Apply/Reset without committing simulated values
  -h, --help          Show this help

Keys:
  GPU list: Up/Down, k/j select a GPU; telemetry + targets stay visible below
            Enter locks that GPU and activates the settings
            R stages stock targets for ALL GPUs
  Settings: Up/Down, k/j select Core, Memory, Power, Fan, Core Offset(VTT),
            Apply, Reset
            Left/Right changes the target by its displayed step
            Each row shows cur, tgt, (delta), [limits], plus a slider below
            it: X = staged target, S = stock/default, * = on default
            FAN starts at AUTO; Left/Right turns it into a numeric slider
            Enter opens exact number entry; type a value and press Enter
            +/- also adjusts the target; 0 discards that target change
            r stock-resets the selected row; R stages stock for all GPUs
            s saves the applied setup (refuses while changes are staged);
            l loads the save as new staged targets (asks before replacing)
            Enter on [Apply] commits; Enter on [Full Reset] stocks + commits
            (a is a keyboard shortcut for Apply)
            Esc returns to the GPU list; q quits; Ctrl+C quits immediately
  Esc with pending changes offers apply, discard, or cancel
  ?                  Show the key reference

Simulation mode only: target edits stay staged until [Apply]/[Full Reset].
Both update simulated UI values and never write settings to the GPU.
Limits are per-model (e.g. 3070 vs 5070); run with --help for details.

Memory locks: when a GPU's memory clock is locked (nvidia-smi -lmc),
offsets do nothing, so the MEMORY row shows LOCKED and its slider,
numeric entry, and reset are disabled. Lock speeds come from live
SUPPORTED_CLOCKS with a built-in 30/40/50-series reference table as
fallback. Lock state is read from gpuoc's state dir, the driver's
Deferred Clocks, or GPUOC_SIM_MEMLOCK="idx:speed,..." for UI testing
(no NVML/driver getter exists for active locks set elsewhere).
EOF
}

die() {
    printf '%s\n' "$*" >&2
    exit 2
}

# Hot-path convention: helpers below both print their result (for legacy
# $(...) callers) and stash it in a global (TRIMMED, SEL, ECV, ...), so the
# per-frame render path can call them directly with >/dev/null and pay zero
# forks instead of one subshell per value.
TRIMMED=''
trim() {
    local value=${1-}
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    TRIMMED=$value
    printf '%s' "$value"
}

is_number() {
    [[ ${1-} =~ ^-?[0-9]+([.][0-9]+)?$ ]]
}

# Rounds to a whole number with pure bash (no awk fork). Result is left in
# $ROUNDED so hot paths avoid even a command-substitution subshell.
ROUNDED='N/A'
round_number() {
    local value=${1-} int frac
    if [[ $value =~ ^(-?[0-9]+)\.([0-9]+)$ ]]; then
        int=${BASH_REMATCH[1]}
        frac=${BASH_REMATCH[2]}
        if (( ${frac:0:1} >= 5 )); then
            if [[ $int == -* ]]; then ROUNDED=$((int - 1)); else ROUNDED=$((int + 1)); fi
        else
            ROUNDED=$int
        fi
    elif [[ $value =~ ^-?[0-9]+$ ]]; then
        ROUNDED=$value
    else
        ROUNDED=${value:-N/A}
    fi
}

fmt_temp() {
    local value=${1-}
    if is_number "$value"; then round_number "$value"; FMT="${ROUNDED}C"; else FMT=${value:-N/A}; fi
    printf '%s' "$FMT"
}

fmt_percent() {
    local value=${1-}
    if is_number "$value"; then round_number "$value"; FMT="${ROUNDED}%"; else FMT=${value:-N/A}; fi
    printf '%s' "$FMT"
}

fmt_watts() {
    local value=${1-}
    if is_number "$value"; then round_number "$value"; FMT="${ROUNDED} W"; else FMT=${value:-N/A}; fi
    printf '%s' "$FMT"
}

FMT=''
fmt_offset() {
    local value=${1-}
    if ! is_number "$value"; then
        FMT=${value:-N/A}
    elif [[ $value == -* ]]; then
        FMT="$value MHz"
    else
        FMT="+$value MHz"
    fi
    printf '%s' "$FMT"
}

fmt_vtt() {
    local value=${1-}
    if ! is_number "$value"; then
        FMT=${value:-N/A}
    elif [[ $value == -* ]]; then
        FMT="$value mV"
    else
        FMT="+$value mV"
    fi
    printf '%s' "$FMT"
}

fmt_memory() {
    local used=${1-} total=${2-} iu it pct gu gt
    is_number "$used" || { FMT='N/A'; printf 'N/A'; return; }
    is_number "$total" || { FMT='N/A'; printf 'N/A'; return; }
    round_number "$used"; iu=$ROUNDED
    round_number "$total"; it=$ROUNDED
    is_number "$iu" || { FMT='N/A'; printf 'N/A'; return; }
    is_number "$it" || { FMT='N/A'; printf 'N/A'; return; }
    (( it == 0 )) && { FMT='N/A'; printf 'N/A'; return; }
    (( iu < 0 )) && iu=0
    pct=$(( (iu * 100 + it / 2) / it ))
    gu=$(( (iu * 10 + 512) / 1024 ))
    gt=$(( (it * 10 + 512) / 1024 ))
    printf -v FMT '%d.%d / %d.%d GiB (%s%%)' "$((gu / 10))" "$((gu % 10))" "$((gt / 10))" "$((gt % 10))" "$pct"
    printf '%s' "$FMT"
}

set_notice() {
    notice=$1
    notice_color=${2:-$dim}
}

# Live terminal size: $TERM_W tracks the real width (startup probe + SIGWINCH
# trap) so borders and sliders follow resizes instead of going stale.
TERM_W=80
update_term_size() {
    local sz rows cols
    sz=$(stty size 2>/dev/null) || return 0
    rows=${sz%% *}; cols=${sz##* }
    is_number "$rows" && (( rows > 0 )) && LINES=$rows
    if is_number "$cols" && (( cols > 0 )); then COLUMNS=$cols; TERM_W=$cols; fi
    (( TERM_W < 40 )) && TERM_W=40
    (( TERM_W > 100 )) && TERM_W=100
    return 0
}

divider_line() {
    local width=$TERM_W fill
    printf -v fill '%*s' "$width" ''
    printf '%s%s%s\n' "$dim" "${fill// /-}" "$reset"
}

equals_line() {
    local width=$TERM_W fill
    printf -v fill '%*s' "$width" ''
    printf '%s%s%s\n' "$dim" "${fill// /=}" "$reset"
}

# htop-style section bar: black text knocked out on a full-width green bar.
bar_green() {
    local text=$1 width=$TERM_W pad
    pad=$(( width - ${#text} ))
    (( pad < 0 )) && pad=0
    printf '%s%s%*s%s\n' "${bold}${bg_green}${black}" "$text" "$pad" '' "$reset"
}

