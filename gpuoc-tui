green=$'\033[32m'
bright_green=$'\033[92m'
yellow=$'\033[33m'
bright_yellow=$'\033[93m'
red=$'\033[31m'
magenta=$'\033[35m'
dim=$'\033[2m'
bold=$'\033[1m'
reset=$'\033[0m'
black=$'\033[30m'
bg_green=$'\033[42m'
bg_yellow=$'\033[43m'
bg_cyan=$'\033[46m'

configure_theme() {
    case $theme in
        matrix)
            cyan=$'\033[36m'; green=$'\033[32m'; bright_green=$'\033[92m'
            yellow=$'\033[33m'; bright_yellow=$'\033[93m'; red=$'\033[31m'; magenta=$'\033[35m'
            dim=$'\033[2m'; bold=$'\033[1m'; reset=$'\033[0m'
            black=$'\033[30m'; bg_green=$'\033[42m'; bg_yellow=$'\033[43m'; bg_cyan=$'\033[46m'
            ;;
        amber)
            cyan=$'\033[38;5;172m'; green=$'\033[38;5;166m'; bright_green=$'\033[38;5;208m'
            yellow=$'\033[38;5;208m'; bright_yellow=$'\033[38;5;202m'; red=$'\033[38;5;202m'
            magenta=$'\033[38;5;166m'; dim=$'\033[38;5;130m'
            bg_green=$'\033[48;5;166m'; bg_yellow=$'\033[48;5;208m'; bg_cyan=$'\033[48;5;172m'
            reset=$'\033[0m\033[38;5;172m\033[40m'
            ;;
        *) die "Unknown theme: $theme (use matrix or amber)." ;;
    esac
    notice_color=$dim
}

theme_preference_path() { printf '%s/gpuoc-tui/theme' "${XDG_CONFIG_HOME:-$HOME/.config}"; }

load_theme() {
    local saved file
    file=$(theme_preference_path)
    [[ -r $file ]] || return 0
    IFS= read -r saved < "$file" || return 0
    [[ $saved == matrix || $saved == amber ]] && theme=$saved
}

set_theme() {
    local next=$1 file dir
    theme=$next
    configure_theme
    file=$(theme_preference_path); dir=${file%/*}
    if mkdir -p "$dir" 2>/dev/null && printf '%s\n' "$theme" > "${file}.tmp" && mv -f "${file}.tmp" "$file"; then
        set_notice "Theme set to ${theme} and saved." "$yellow"
    else
        set_notice "Theme set to ${theme}, but could not save ${file}." "$red"
    fi
}

