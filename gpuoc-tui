# Cache for resolved caps strings, keyed by model name. The case table above
# is pure bash now (no tr/cut/awk), so even a miss costs no process forks.
declare -A caps_cache=()

cached_caps_string() {
    local model=${1-}
    if [[ -z ${caps_cache[$model]+set} ]]; then
        caps_cache[$model]=$(sane_caps_for_model "$model")
    fi
    printf '%s' "${caps_cache[$model]}"
}

# Silent caps resolver for hot paths: sets $CAP_STOCK/$CAP_CORE/$CAP_MEM/
# $CAP_VTT for a GPU index with no output and (after first miss) no forks.
CAP_STOCK=250 CAP_CORE=500 CAP_MEM=3000 CAP_VTT=50
caps_for_index() {
    local idx=$1 model caps
    model=${gpu_name[$idx]-}
    if [[ -z ${caps_cache[$model]+set} ]]; then
        caps_cache[$model]=$(sane_caps_for_model "$model")
    fi
    caps=${caps_cache[$model]}
    IFS=: read -r CAP_STOCK CAP_CORE CAP_MEM CAP_VTT <<< "$caps"
    is_number "$CAP_STOCK" || CAP_STOCK=250
    is_number "$CAP_CORE" || CAP_CORE=500
    is_number "$CAP_MEM" || CAP_MEM=3000
    is_number "$CAP_VTT" || CAP_VTT=50
}

sane_core_max() {
    local caps rest
    caps=$(cached_caps_string "${gpu_name[$1]-}")
    rest=${caps#*:}
    printf '%s' "${rest%%:*}"
}

sane_mem_max() {
    local caps rest
    caps=$(cached_caps_string "${gpu_name[$1]-}")
