}

# The wide console mirrors the 88-column layout while keeping each row exactly
# 88 display cells. Build text without embedded SGR codes, then color the whole
# row: byte counts from the telemetry locale must never become border padding.
UI_INNER=86
ui_line() {
    local LC_ALL=C.UTF-8 content=${1-} color=${2:-$cyan} pad
    if (( ${#content} > UI_INNER )); then content=${content:0:UI_INNER}; fi
    printf -v pad '%*s' "$((UI_INNER - ${#content}))" ''
    printf '%s║%s%s║%s\n' "$color" "$content" "$pad" "$reset"
}

ui_rule() {
    local LC_ALL=C.UTF-8 left=$1 middle=$2 right=$3 title=${4-} color=${5:-$cyan} prefix='' fill pad
    [[ -n $title ]] && prefix="${middle}${middle} ${title} "
    pad=$((UI_INNER - ${#prefix}))
    printf -v fill '%*s' "$pad" ''
    fill=${fill// /$middle}
    printf '%s%s%s%s%s%s\n' "$color" "$left" "$prefix" "$fill" "$right" "$reset"
}

ui_card_border() {
    local fill side=$1
    printf -v fill '%80s' ''
    fill=${fill// /─}
    if [[ $side == top ]]; then
        ui_line "  ┌${fill}┐  "
    else
        ui_line "  └${fill}┘  "
    fi
}

ui_card_line() {
    local LC_ALL=C.UTF-8 content text=${1-} color=${2:-$cyan} pad
    if (( ${#text} > 78 )); then text=${text:0:78}; fi
    printf -v pad '%*s' "$((78 - ${#text}))" ''
    content="  │ ${text}${pad} │  "
    ui_line "$content" "$color"
}

UI_PADDED=''
ui_pad() {
    local LC_ALL=C.UTF-8 value=${1-} width=$2 pad
    if (( ${#value} > width )); then value=${value:0:width}; fi
    printf -v pad '%*s' "$((width - ${#value}))" ''
    UI_PADDED="${value}${pad}"
}

ui_control_label() {
    case $1 in
        0) printf 'CORE CLOCK' ;;
        1) printf 'MEMORY OFFSET' ;;
        2) printf 'POWER LIMIT' ;;
        3) printf 'FAN SPEED' ;;
        4) printf 'CORE VOLTAGE' ;;
        5) printf 'MEMORY SPEED' ;;
    esac
}

# One-cell markers keep the current, staged, and stock points visible even
# when they overlap. The lock and unsupported rows get an explicit message.
ui_meter() {
    local index=$1 field=$2 color=$3 min max stock current target step track='' glyph
    local i width=55 current_pos=-1 target_pos=-1 stock_pos=-1 message=''
    step_for_field "$index" "$field" >/dev/null; step=$STP
    case $field in
        0)
            min=-$CAP_CORE; max=$CAP_CORE; stock=0
            effective_current_value "$index" 0 >/dev/null; current=$ECV
            target=${target_core[$index]-N/A}
            ;;
        1)
            if memory_offset_target_locked "$index"; then
                message="DISABLED BY FIXED ${target_memlock[$index]} MHz MEMORY SPEED"
            else
                min=-$CAP_MEM; max=$CAP_MEM; stock=0
                effective_current_value "$index" 1 >/dev/null; current=$ECV
                memlocked "$index" && current='N/A'
                target=${target_memory[$index]-N/A}
            fi
            ;;
        2)
            min=${gpu_power_min[$index]-N/A}; max=${gpu_power_max[$index]-N/A}
            stock=${gpu_power_default[$index]-N/A}
            effective_current_value "$index" 2 >/dev/null; current=$ECV
            target=${target_power[$index]-N/A}
            ;;
        3)
            min=20; max=100; stock='N/A'
            effective_current_value "$index" 3 >/dev/null; current=$ECV
            target=${target_fan[$index]-}
            [[ -z $target ]] && message='AUTO FAN CONTROL'
            (( current == 0 )) && current='N/A'
            ;;
        4)
            min=-$CAP_VTT; max=$CAP_VTT; stock=0
            effective_current_value "$index" 4 >/dev/null; current=$ECV
            target=${target_vtt[$index]-N/A}
            if ! is_number "$current"; then message='NOT AVAILABLE'; step=''; fi
            ;;
        5)
            min=0; max=0; stock=0
            for i in ${memspd_choices[$index]-}; do max=$i; done
            current=$(effective_memlock "$index")
            target=${target_memlock[$index]-0}
            step='reported clock'
            ;;
    esac
    if [[ -z $message ]]; then
        if ! is_number "${min-}" || ! is_number "${max-}" || ! is_number "${target-}" || (( max <= min )); then
            message='NOT AVAILABLE'
        fi
    fi
    if [[ -n $message ]]; then
        ui_pad "── ${message} ──" "$width"; track=$UI_PADDED
        ui_line "    ╭${track}╮  ${step}" "$color"
        return
    fi
    (( target < min )) && target=$min
    (( target > max )) && target=$max
    target_pos=$(( (target - min) * (width - 1) / (max - min) ))
    if is_number "$current"; then
        (( current < min )) && current=$min
        (( current > max )) && current=$max
        current_pos=$(( (current - min) * (width - 1) / (max - min) ))
    fi
    if is_number "$stock"; then
        (( stock < min )) && stock=$min
        (( stock > max )) && stock=$max
        stock_pos=$(( (stock - min) * (width - 1) / (max - min) ))
    fi
    for (( i=0; i<width; i++ )); do
        glyph='░'
        (( i < target_pos )) && glyph='━'
        if (( i == stock_pos )); then glyph='S'; fi
        if (( i == current_pos )); then glyph='C'; fi
        if (( i == target_pos )); then glyph='T'; fi
        if (( i == current_pos && i == target_pos )); then glyph='◎'; fi
        track+=$glyph
    done
    ui_line "    ╭${track}╮  ${step}" "$color"
}

ui_control_row() {
    local LC_ALL=C.UTF-8 index=$1 field=$2 label current target limit marker=' ' color=$reset content
    label=$(ui_control_label "$field")
    field_current_display "$index" "$field" >/dev/null; current=$FCD
    field_target_display "$index" "$field" >/dev/null; target=$FTD
    limit_for_field "$index" "$field" >/dev/null; limit=$LIM
    if [[ $screen == settings ]]; then color=$cyan; fi
    if [[ $screen == settings ]] && (( selected_field == field )); then marker='▶'; color="$bold$bright_yellow"; fi
    if field_is_pending "$index" "$field"; then target+=' ◈'; fi
    content="  ${marker} "
    ui_pad "$label" 17; content+="$UI_PADDED "
    ui_pad "$current" 12; content+="$UI_PADDED "
    ui_pad "$target" 13; content+="$UI_PADDED "
    ui_pad "$limit" 29; content+=$UI_PADDED
    ui_line "$content" "$color"
    ui_meter "$index" "$field" "$color"
    ui_line '' "$cyan"
}

