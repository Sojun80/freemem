limits_summary_for_gpu() {
    local index=$1 core_max mem_max vtt_max pmin pmax
    core_max=$(sane_core_max "$index")
    mem_max=$(sane_mem_max "$index")
    vtt_max=$(sane_vtt_max "$index")
    pmin=${gpu_power_min[$index]-N/A}
    pmax=${gpu_power_max[$index]-N/A}
    if ! is_number "$pmin" || ! is_number "$pmax"; then
        pmin=$(sane_stock_watts "$index")
        pmax=$pmin
    fi
    printf 'CORE +/-%s  MEM +/-%s  PWR %s-%sW  FAN 20-100/AUTO  VTT +/-%s' \
        "$core_max" "$mem_max" "$pmin" "$pmax" "$vtt_max"
}

