        *'3070'*'LAPTOP'*|*'3070'*'MOBILE'*|*'3070'*'MAX-Q'*|*'3070'*'MAXQ'*) printf '810:6000'; return ;;
        *'3070'*) printf '810:5001'; return ;;
        *'3060 TI'*|*'3060TI'*) printf '810:7001'; return ;;
        *'3060'*) printf '810:7501'; return ;;
        *'3050'*) printf '810:7001'; return ;;
        *'2080 TI'*|*'2080TI'*) printf '810:7001'; return ;;
