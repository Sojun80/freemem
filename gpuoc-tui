read_escape_key() {
    local second third next digits
    if ! IFS= read -r -s -n1 -t 0.05 second; then printf 'ESC'; return; fi
    if [[ $second != '[' && $second != O ]]; then printf 'ESC'; return; fi
    if ! IFS= read -r -s -n1 -t 0.05 third; then printf 'ESC'; return; fi
    case $third in
        A) printf 'UP'; return ;;
        B) printf 'DOWN'; return ;;
        C) printf 'RIGHT'; return ;;
        D) printf 'LEFT'; return ;;
        P) [[ $second == O ]] && { printf 'F1'; return; } ;;
        Q) [[ $second == O ]] && { printf 'F2'; return; } ;;
    esac
    if [[ $second == '[' && $third =~ ^[0-9]$ ]]; then
        digits=$third
        while IFS= read -r -s -n1 -t 0.05 next; do
            [[ $next == '~' ]] && break
            [[ $next =~ ^[0-9]$ ]] || { printf 'UNKNOWN'; return; }
            digits+=$next
            ((${#digits} <= 3)) || { printf 'UNKNOWN'; return; }
        done
        case $digits in
            11) printf 'F1' ;;
            12) printf 'F2' ;;
            15) printf 'F5' ;;
            17) printf 'F6' ;;
            18) printf 'F7' ;;
            19) printf 'F8' ;;
            *) printf 'UNKNOWN' ;;
        esac
        return
    fi
    printf 'UNKNOWN'
}

read_key() {
    local first
    if ! IFS= read -r -s -n1 -t "$refresh_interval" first; then
        printf '__TIMEOUT__'
        return
    fi
    if [[ -z $first ]]; then
        printf 'ENTER'
        return
    fi
    case $first in
        $'\e') read_escape_key ;;
        $'\t') printf 'TAB' ;;
        $'\r'|$'\n') printf 'ENTER' ;;
        $'\177'|$'\b') printf 'BACKSPACE' ;;
        *) printf '%s' "$first" ;;
    esac
}

read_key_blocking() {
    local key
    IFS= read -r -s -n1 key
    printf '%s' "$key"
}

# Non-blocking twin of read_key for key-repeat coalescing: inspects input
# already queued behind the key being handled and reports one extra key in
# $EXTRA (canonical LEFT/RIGHT/UP/DOWN, ENTER, ESC, or the raw byte), or
# returns 1 when the queue is empty. Never blocks: `read -t 0` only polls,
# so a first-byte poll is followed by a consume read, and escape-sequence
# continuations get a short grace window (burst bytes arrive together).
EXTRA=''
read_extra_key() {
    local b1 dummy
    EXTRA=''
    IFS= read -r -s -n1 -t 0 dummy || return 1
    IFS= read -r -s -n1 -t 0.05 b1 || return 1
    if [[ -z $b1 ]]; then EXTRA='ENTER'; return 0; fi
    case $b1 in
        $'\e') EXTRA=$(read_escape_key) ;;
        $'\t') EXTRA='TAB' ;;
        $'\r'|$'\n') EXTRA='ENTER' ;;
        h) EXTRA='LEFT' ;;
        k) EXTRA='UP' ;;
        j) EXTRA='DOWN' ;;
        +|=) EXTRA='RIGHT' ;;
        -|_) EXTRA='LEFT' ;;
        # NOTE: raw l stays l (load plan), NOT Right: the load binding owns it.
        *) EXTRA=$b1 ;;
    esac
    return 0
}

handle_key() {
    local key=$1
    case $key in
        F1) set_theme matrix; return ;;
        F2) set_theme amber; return ;;
        q|Q) exit 0 ;;
    esac
    if (( numeric_entry )); then
        handle_numeric_entry_key "$key"
        return
    fi
    case $key in
        F5)
            if [[ $screen == settings ]]; then apply_pending 1; else set_notice 'Press Enter to lock a GPU before applying.' "$dim"; fi
            return
            ;;
        F6)
            if [[ $screen == settings ]]; then reset_selected; else set_notice 'Press Enter to lock a GPU before resetting.' "$dim"; fi
            return
            ;;
        F7)
            save_plan
            return
            ;;
        F8)
            if [[ $screen == settings ]]; then load_plan; else set_notice 'Press Enter to lock a GPU before loading targets.' "$dim"; fi
            return
            ;;
        TAB)
            local resume_edit=0
            ((${#gpu_indices[@]} > 0)) || { set_notice 'No GPU is available to select.' "$dim"; return; }
            if [[ $screen == settings ]]; then
                leave_settings picker || return
                resume_edit=1
            fi
            selected_gpu=$(( (selected_gpu + 1) % ${#gpu_indices[@]} ))
            if (( resume_edit )); then
                active_gpu=$(selected_gpu_id)
                screen='settings'
                selected_field=0
                set_notice "Editing ${gpu_name[$active_gpu]}. GPU locked; Tab switches GPU." "$yellow"
            else
                set_notice "Selected GPU $(selected_gpu_id). Press Enter to edit." "$dim"
            fi
            return
            ;;
    esac
    if [[ $screen == picker ]]; then
        case $key in
            UP|k)
                selected_gpu=$((selected_gpu - 1))
                (( selected_gpu < 0 )) && selected_gpu=$((${#gpu_indices[@]} - 1))
                set_notice "Selected GPU $(selected_gpu_id)." "$dim"
                ;;
            DOWN|j)
                selected_gpu=$((selected_gpu + 1))
                (( selected_gpu >= ${#gpu_indices[@]} )) && selected_gpu=0
                set_notice "Selected GPU $(selected_gpu_id)." "$dim"
                ;;
            ENTER)
                active_gpu=$(selected_gpu_id)
                [[ -n $active_gpu ]] || return
                screen='settings'
                selected_field=0
                set_notice "Editing ${gpu_name[$active_gpu]}. GPU locked; use Esc to return." "$yellow"
                ;;
            r|R)
                set_notice 'Press Enter to lock a GPU before resetting targets.' "$dim"
                ;;
            s|S)
                save_plan
                ;;
            l|L)
                set_notice 'Press Enter to lock a GPU before loading targets.' "$dim"
                ;;
            ESC|q|Q)
                exit 0
                ;;
            '?')
                draw_help
                read_key_blocking >/dev/null
                set_notice 'Returned to GPU list.' "$dim"
                ;;
        esac
        return
    fi

    case $key in
        UP|k)
            selected_field=$((selected_field - 1))
            (( selected_field < 0 )) && selected_field=7
            set_notice "Editing $(field_name) target." "$dim"
            ;;
        DOWN|j)
            selected_field=$((selected_field + 1))
            (( selected_field > 7 )) && selected_field=0
            set_notice "Editing $(field_name) target." "$dim"
            ;;
        LEFT|h)
            if (( selected_field >= 6 )); then
                set_notice 'Use Enter on [Apply]/[Reset], or F5/F6.' "$dim"
            else
                adjust_selected -1
            fi
            ;;
        RIGHT)
            if (( selected_field >= 6 )); then
                set_notice 'Use Enter on [Apply]/[Reset], or F5/F6.' "$dim"
            else
                adjust_selected 1
            fi
            ;;
        ENTER)
            if (( selected_field == 6 )); then
                apply_pending 1
            elif (( selected_field == 7 )); then
                reset_selected
            else
                begin_numeric_entry
            fi
            ;;
        +|=)
            if (( selected_field >= 6 )); then
                set_notice 'Use Enter on [Apply]/[Reset], or F5/F6.' "$dim"
            else
                adjust_selected 1
            fi
            ;;
        -|_)
            if (( selected_field >= 6 )); then
                set_notice 'Use Enter on [Apply]/[Reset], or F5/F6.' "$dim"
            else
                adjust_selected -1
            fi
            ;;
        0)
            discard_selected
            ;;
        a|A)
            apply_pending
            ;;
        r)
            if (( selected_field <= 5 )); then
                reset_field_to_stock
            else
                reset_selected
            fi
            ;;
        R)
            reset_all_gpus
            ;;
        s|S)
            save_plan
            ;;
        l|L)
            load_plan
            ;;
        '?')
            draw_help
            read_key_blocking >/dev/null
            set_notice "Returned to GPU ${active_gpu} settings." "$dim"
            ;;
        ESC)
            leave_settings picker || true
            ;;
        q|Q)
            leave_settings quit || true
            ;;
    esac
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -r|--refresh)
            [[ $# -ge 2 ]] || die "${1} requires a positive number of seconds."
            refresh_interval=$2
            shift 2
            ;;
        --theme)
            [[ $# -ge 2 ]] || die '--theme requires matrix or amber.'
            theme=$2
            theme_from_cli=1
            shift 2
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -V|--version)
            printf '%s\n' "$gpuoc_tui_version"
            exit 0
            ;;
        *)
            die "Unknown option: $1 (try --help)."
            ;;
    esac
done

[[ ${theme_from_cli:-0} == 1 ]] || load_theme
configure_theme

if [[ ! $refresh_interval =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || \
    ! awk -v value="$refresh_interval" 'BEGIN { exit !(value > 0) }'; then
    die 'Refresh interval must be a positive number, such as 1 or .5.'
fi
[[ -t 0 && -t 1 ]] || die 'gpuoc-tui needs an interactive terminal.'
command -v nvidia-smi >/dev/null 2>&1 || die 'nvidia-smi is required.'

stty_state=$(stty -g) || die 'Could not read terminal settings.'
stty -echo -icanon min 0 time 0
shopt -s checkwinsize 2>/dev/null || true
cleanup() {
    stty "$stty_state" 2>/dev/null || true
    printf '\033[?25h\033[0m\n'
}
# Ctrl+C / kill must actually leave: the old shared EXIT/INT/TERM trap ran
# cleanup and then fell back into the input loop with a restored terminal.
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM
trap 'update_term_size' WINCH
printf '\033[?25l%s' "$reset"
update_term_size

discover_settings_gpus
refresh_telemetry >/dev/null || true
refresh_settings >/dev/null || true
probe_mem_speeds
probe_mem_locks
set_notice 'Simulation only: adjust targets, then press a to simulate apply.' "$yellow"

# A held key repeats faster than a full redraw, so without coalescing the
# input queue grows and the UI keeps "moving" long after release. Burst
# repeats of movement/adjust keys are drained (cap 64), applied at once,
# and drawn once; a different queued key is stashed for next iteration.
pending_key=''
while :; do
    draw
    if [[ -n $pending_key ]]; then
        key=$pending_key
        pending_key=''
    else
        key=$(read_key)
    fi
    # Fast path only: telemetry is ~70ms, settings are ~800ms and cached.
    # Settings are loaded once at startup; offsets don't change under sim.
    [[ $key == __TIMEOUT__ ]] && { refresh_telemetry >/dev/null || true; if memspeeds_pending; then probe_mem_speeds; probe_mem_locks; fi; continue; }
    if (( ! numeric_entry )); then
        case $key in
            LEFT|h) key=LEFT ;;
            RIGHT) key=RIGHT ;;
            UP|k) key=UP ;;
            DOWN|j) key=DOWN ;;
            +|=) key=RIGHT ;;
            -|_) key=LEFT ;;
            *) handle_key "$key"; continue ;;
        esac
        count=1
        while (( count < 64 )); do
            read_extra_key || break
            [[ $EXTRA == "$key" ]] || { pending_key=$EXTRA; break; }
            ((count++))
        done
        for (( i = 0; i < count; i++ )); do handle_key "$key"; done
    else
        handle_key "$key"
    fi
done
