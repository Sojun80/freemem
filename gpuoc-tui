#!/usr/bin/env bash
# gpuoc-tui - keyboard-driven NVIDIA GPU overclocking prototype.
#
# Settings and Apply/Reset are simulated in this UI; no hardware write path is
# available here. Telemetry remains live and read-only.

set -u

LC_ALL=C
export LC_ALL

gpuoc_tui_version='0.6.0'
refresh_interval='1'
dry_run=0
theme='matrix'
theme_from_cli=0

