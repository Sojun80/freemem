# The mode picker is deliberately smaller than the driver's full clock list.
# DEFAULT (0) leaves memory unlocked so its offset remains usable. Fixed
# speeds are offered only when the driver (or exact fallback endpoint) reports
# them for this GPU; adjacent models do not necessarily share every point.
memlock_choices_for_model() {
    local model=${1^^} reported=$2 allowed speed candidate result=''
    case $model in
        *'RTX 50'[1-9][0-9]*) allowed='810' ;;
        *'RTX 30'[1-9][0-9]*|*'RTX 40'[1-9][0-9]*) allowed='810 5000 5001 6000' ;;
        *) printf '%s' "$reported"; return ;;
    esac
    for candidate in $allowed; do
        for speed in $reported; do
            if [[ $speed == "$candidate" ]]; then
                result+=" ${candidate}"
                break
            fi
        done
    done
    printf '%s' "${result# }"
}

memlock_state_file() {
    printf '%s/gpuoc/memlock' "${XDG_CACHE_HOME:-$HOME/.cache}"
}

# Resolve per-GPU memory speeds (live SUPPORTED_CLOCKS, fallback table) and
# memory-lock state (state file, deferred-clocks probe, sim override).
# Startup slow-path only; results cached in memspd_*/memlock_speed assocs.
probe_mem_speeds() {
    local index speeds line num lo hi options
    for index in "${gpu_indices[@]}"; do
        [[ -n ${memspd_probed[$index]-} ]] && continue
        lo=''; hi=''; options=''
        if speeds=$(nvidia-smi --query-supported-clocks=memory --format=csv,noheader -i "$index" 2>/dev/null) && [[ -n $speeds ]]; then
            while IFS= read -r line; do
                num=${line//[^0-9]/}
                [[ -n $num ]] || continue
                if [[ -z $lo || $num -lt $lo ]]; then lo=$num; fi
                if [[ -z $hi || $num -gt $hi ]]; then hi=$num; fi
                options+=" $num"
            done <<< "$speeds"
        fi
        if [[ -z $lo || -z $hi ]]; then
            speeds=$(memspeeds_for_model "${gpu_name[$index]-}")
            if [[ $speeds == *:* ]]; then
                lo=${speeds%%:*}; hi=${speeds##*:}
                options=" $lo $hi"
                # 810 MHz is an explicit 30/40/50-series choice even when
                # the driver cannot return its supported-clock list.
                case ${gpu_name[$index]^^} in
                    *'RTX 30'[1-9][0-9]*|*'RTX 40'[1-9][0-9]*|*'RTX 50'[1-9][0-9]*)
                        if (( lo <= 810 && hi >= 810 )); then options+=' 810'; fi
                        ;;
                esac
            fi
        fi
        if is_number "$lo" && is_number "$hi" && (( hi > 0 )); then
            memspd_min[$index]=$lo
            memspd_max[$index]=$hi
            memspd_options[$index]=$(for num in $options; do printf '%s\n' "$num"; done | sort -n -u | paste -sd' ' -)
            memspd_choices[$index]=$(memlock_choices_for_model "${gpu_name[$index]-}" "${memspd_options[$index]}")
        else
            unset "memspd_min[$index]" "memspd_max[$index]" "memspd_options[$index]" "memspd_choices[$index]"
        fi
        memspd_probed[$index]=1
    done
}

probe_mem_locks() {
    local index bus clocks line cur_bus in_deferred num state_file entry eidx espec
    # 1. Locks recorded by gpuoc (BUS SPEED lines).
    state_file=$(memlock_state_file)
    if [[ -f $state_file ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
            [[ $line =~ ^([^[:space:]]+)[[:space:]]+([0-9]+) ]] || continue
            bus=${BASH_REMATCH[1]}; num=${BASH_REMATCH[2]}
            for index in "${gpu_indices[@]}"; do
                if [[ ${gpu_bus[$index]-} == "$bus" ]]; then
                    memlock_speed[$index]=$num
                fi
            done
        done < "$state_file"
    fi
    # 2. Deferred (-lmcd) locks from the driver; driver truth wins.
    if clocks=$(nvidia-smi -q -d CLOCK 2>/dev/null) && [[ -n $clocks ]]; then
        cur_bus=''; in_deferred=0
        while IFS= read -r line; do
            if [[ $line =~ ^GPU\ ([0-9A-Fa-f:.]+) ]]; then
                cur_bus=${BASH_REMATCH[1]}; in_deferred=0
            elif [[ $line == '    Deferred Clocks' ]]; then
                in_deferred=1
            elif [[ $line =~ ^'    '[A-Z] ]]; then
                in_deferred=0
            elif (( in_deferred )) && [[ $line =~ Memory\ +:\ +([0-9]+) ]]; then
                num=${BASH_REMATCH[1]}
                for index in "${gpu_indices[@]}"; do
                    if [[ ${gpu_bus[$index]-} == "$cur_bus" ]]; then
                        memlock_speed[$index]=$num
                    fi
                done
            fi
        done <<< "$clocks"
    fi
    # 3. Simulation override for UI testing (IDX:SPEED,...); wins outright.
    if [[ -n ${GPUOC_SIM_MEMLOCK-} ]]; then
        IFS=',' read -ra entry <<< "$GPUOC_SIM_MEMLOCK"
        for eidx in "${entry[@]}"; do
            [[ $eidx =~ ^([0-9]+):([0-9]+)$ ]] || continue
            espec=${BASH_REMATCH[1]}; num=${BASH_REMATCH[2]}
            memlock_speed[$espec]=$num
        done
    fi
    for index in "${gpu_indices[@]}"; do
        if [[ -z ${dirty_memlock[$index]+set} ]]; then
            target_memlock[$index]=$(effective_memlock "$index")
        fi
    done
}

memspeeds_pending() {
    local index
    for index in "${gpu_indices[@]}"; do
        [[ -n ${memspd_probed[$index]-} ]] || return 0
    done
    return 1
}

pci_bus_number() {
    local bus_id=${1-}
    if [[ $bus_id =~ :([0-9A-Fa-f]{2}): ]]; then
        printf '%d' "$((16#${BASH_REMATCH[1]}))"
    elif [[ $bus_id =~ ^([0-9A-Fa-f]{2}): ]]; then
        printf '%d' "$((16#${BASH_REMATCH[1]}))"
    fi
}

ECV='N/A'
effective_current_value() {
    local index=$1 field=$2 value
    case $field in
        0)
            if [[ ${simulated_core[$index]+set} ]]; then value=${simulated_core[$index]}; else value=${current_core[$index]-N/A}; fi
            ;;
        1)
            if [[ ${simulated_memory[$index]+set} ]]; then value=${simulated_memory[$index]}; else value=${current_memory[$index]-N/A}; fi
            ;;
        2)
            if [[ ${simulated_power[$index]+set} ]]; then value=${simulated_power[$index]}; else value=${gpu_power_limit[$index]-N/A}; fi
            ;;
        3)
            if [[ ${simulated_fan[$index]+set} ]]; then
                value=${simulated_fan[$index]}
            else
                value=${gpu_fan[$index]-0}
            fi
            if ! is_number "$value" || (( value <= 0 )); then value=0; fi
            ;;
        4)
            if [[ ${simulated_vtt[$index]+set} ]]; then value=${simulated_vtt[$index]}; else value=${current_vtt[$index]-N/A}; fi
            ;;
    esac
    ECV=$value
    printf '%s' "$value"
}

EFT=''
effective_fan_target() {
    local index=$1 value
    EFT=''
    if [[ ${simulated_fan[$index]+set} ]]; then
        EFT=${simulated_fan[$index]}
        printf '%s' "$EFT"
        return
    fi
    value=${gpu_fan[$index]-}
    if is_number "$value" && (( value > 0 )); then EFT=$value; printf '%s' "$value"; fi
}

discover_settings_gpus() {
    local settings_gpu bus bus_decimal
    settings_gpu_by_bus=()
    command -v nvidia-settings >/dev/null 2>&1 || return

    for settings_gpu in $(seq 0 31); do
        bus=$(nvidia-settings -q "[gpu:${settings_gpu}]/PCIBus" -t 2>/dev/null \
            | awk 'NF { gsub(/[[:space:]]/, ""); print; exit }')
        if [[ $bus =~ ^0[xX]([0-9A-Fa-f]+)$ ]]; then
            bus_decimal=$((16#${BASH_REMATCH[1]}))
        elif [[ $bus =~ ^[0-9]+$ ]]; then
            bus_decimal=$bus
        else
            [[ $settings_gpu -gt 0 ]] && break
            continue
        fi
        settings_gpu_by_bus[$bus_decimal]=$settings_gpu
    done
}

settings_index_for_bus() {
    local bus_decimal
    bus_decimal=$(pci_bus_number "$1")
    [[ -n $bus_decimal && -n ${settings_gpu_by_bus[$bus_decimal]-} ]] || return 1
    printf '%s' "${settings_gpu_by_bus[$bus_decimal]}"
}

query_setting_number() {
    local settings_gpu=$1 attribute=$2 value
    value=$(nvidia-settings -q "[gpu:${settings_gpu}]/${attribute}" -t 2>/dev/null \
        | awk 'match($0, /-?[0-9]+([.][0-9]+)?/) { print substr($0, RSTART, RLENGTH); exit }')
    [[ -n $value ]] && printf '%s' "$value"
}

query_offset() {
    local settings_gpu=$1 attribute=$2 value
    value=$(query_setting_number "$settings_gpu" "${attribute}AllPerformanceLevels")
    if is_number "$value"; then
        round_number "$value"; printf '%s' "$ROUNDED"
        return
    fi
    value=$(query_setting_number "$settings_gpu" "${attribute}[0]")
    if is_number "$value"; then
        round_number "$value"; printf '%s' "$ROUNDED"
    else
        printf 'N/A'
    fi
}

query_vtt_offset() {
    local settings_gpu=$1 value
    value=$(query_setting_number "$settings_gpu" GPUOverVoltageOffset)
    if is_number "$value"; then
        awk -v value="$value" 'BEGIN { printf "%.0f", value / 1000 }'
    else
        printf 'N/A'
    fi
}

refresh_telemetry() {
    local rows index name bus temp draw limit default_power min_power max_power
    local used total gclock mclock fan pstate old_index
    local -A seen=()

    rows=$(nvidia-smi \
        --query-gpu=index,name,pci.bus_id,temperature.gpu,power.draw,power.limit,power.default_limit,power.min_limit,power.max_limit,memory.used,memory.total,clocks.current.graphics,clocks.current.memory,fan.speed,pstate \
        --format=csv,noheader,nounits 2>/dev/null) || {
        set_notice 'Unable to read GPU telemetry from nvidia-smi.' "$red"
        return 1
    }
    [[ -n $rows ]] || {
        set_notice 'No NVIDIA GPUs were reported by nvidia-smi.' "$red"
        return 1
    }

    gpu_indices=()
    while IFS=',' read -r index name bus temp draw limit default_power min_power max_power used total gclock mclock fan pstate; do
        trim "$index" >/dev/null; index=$TRIMMED
        [[ $index =~ ^[0-9]+$ ]] || continue
        trim "$name" >/dev/null; name=$TRIMMED
        name=${name#NVIDIA }
        name=${name#GeForce }
        trim "$bus" >/dev/null; bus=$TRIMMED
        gpu_indices+=("$index")
        seen[$index]=1
        gpu_name[$index]=$name
        gpu_bus[$index]=$bus
        trim "$temp" >/dev/null; gpu_temp[$index]=$TRIMMED
        trim "$draw" >/dev/null; round_number "$TRIMMED"; gpu_power_draw[$index]=$ROUNDED
        trim "$limit" >/dev/null; round_number "$TRIMMED"; gpu_power_limit[$index]=$ROUNDED
        trim "$default_power" >/dev/null; round_number "$TRIMMED"; gpu_power_default[$index]=$ROUNDED
        trim "$min_power" >/dev/null; round_number "$TRIMMED"; gpu_power_min[$index]=$ROUNDED
        trim "$max_power" >/dev/null; round_number "$TRIMMED"; gpu_power_max[$index]=$ROUNDED
        trim "$used" >/dev/null; round_number "$TRIMMED"; gpu_memory_used[$index]=$ROUNDED
        trim "$total" >/dev/null; round_number "$TRIMMED"; gpu_memory_total[$index]=$ROUNDED
        trim "$gclock" >/dev/null; round_number "$TRIMMED"; gpu_graphics_clock[$index]=$ROUNDED
        trim "$mclock" >/dev/null; round_number "$TRIMMED"; gpu_memory_clock[$index]=$ROUNDED
        trim "$fan" >/dev/null; round_number "$TRIMMED"; gpu_fan[$index]=$ROUNDED
        trim "$pstate" >/dev/null; gpu_pstate[$index]=$TRIMMED
        caps_for_index "$index"

        if [[ -z ${dirty_power[$index]+set} ]]; then effective_current_value "$index" 2 >/dev/null; target_power[$index]=$ECV; fi
        if [[ -z ${dirty_fan[$index]+set} ]]; then
            effective_fan_target "$index" >/dev/null; target_fan[$index]=$EFT
        fi
        # Core/mem/VTT targets are owned by refresh_settings (slow path).
        if [[ -z ${dirty_core[$index]+set} && -n ${current_core[$index]-} ]]; then effective_current_value "$index" 0 >/dev/null; target_core[$index]=$ECV; fi
        if [[ -z ${dirty_memory[$index]+set} && -n ${current_memory[$index]-} ]]; then effective_current_value "$index" 1 >/dev/null; target_memory[$index]=$ECV; fi
        if [[ -z ${dirty_vtt[$index]+set} && -n ${current_vtt[$index]-} ]]; then effective_current_value "$index" 4 >/dev/null; target_vtt[$index]=$ECV; fi
    done <<< "$rows"

    for old_index in "${!gpu_name[@]}"; do
        [[ -n ${seen[$old_index]-} ]] || {
            unset "gpu_name[$old_index]" "gpu_bus[$old_index]" "gpu_power_default[$old_index]" "current_core[$old_index]" "current_memory[$old_index]" "current_vtt[$old_index]"
            unset "simulated_core[$old_index]" "simulated_memory[$old_index]" "simulated_vtt[$old_index]" "simulated_power[$old_index]" "simulated_fan[$old_index]"
            unset "simulated_memlock[$old_index]" "memlock_speed[$old_index]" "memspd_min[$old_index]" "memspd_max[$old_index]" "memspd_options[$old_index]" "memspd_choices[$old_index]" "memspd_probed[$old_index]"
            unset "target_core[$old_index]" "target_memory[$old_index]" "target_vtt[$old_index]" "target_power[$old_index]" "target_fan[$old_index]" "target_memlock[$old_index]"
            unset "dirty_core[$old_index]" "dirty_memory[$old_index]" "dirty_vtt[$old_index]" "dirty_power[$old_index]" "dirty_fan[$old_index]" "dirty_memlock[$old_index]"
        }
    done

    if ((${#gpu_indices[@]} == 0)); then
        set_notice 'No usable NVIDIA GPU records were returned.' "$red"
        return 1
    fi
    if (( selected_gpu >= ${#gpu_indices[@]} )); then
        selected_gpu=$((${#gpu_indices[@]} - 1))
    fi
    return 0
}

refresh_settings() {
    local force=${1-} index bus settings_index
    command -v nvidia-settings >/dev/null 2>&1 || return 0
    for index in "${gpu_indices[@]}"; do
        if [[ -z $force && -n ${current_core[$index]-} && -n ${current_memory[$index]-} && -n ${current_vtt[$index]-} ]]; then
            continue
        fi
        bus=${gpu_bus[$index]-}
        settings_index=''
        if settings_index=$(settings_index_for_bus "$bus"); then
            gpu_settings_index[$index]=$settings_index
            current_core[$index]=$(query_offset "$settings_index" GPUGraphicsClockOffset)
            current_memory[$index]=$(query_offset "$settings_index" GPUMemoryTransferRateOffset)
            current_vtt[$index]=$(query_vtt_offset "$settings_index")
        else
            gpu_settings_index[$index]=''
            [[ -n ${current_core[$index]-} ]] || current_core[$index]='N/A'
            [[ -n ${current_memory[$index]-} ]] || current_memory[$index]='N/A'
            [[ -n ${current_vtt[$index]-} ]] || current_vtt[$index]='N/A'
        fi
        if [[ -z ${dirty_core[$index]+set} ]]; then effective_current_value "$index" 0 >/dev/null; target_core[$index]=$ECV; fi
        if [[ -z ${dirty_memory[$index]+set} ]]; then effective_current_value "$index" 1 >/dev/null; target_memory[$index]=$ECV; fi
        if [[ -z ${dirty_vtt[$index]+set} ]]; then effective_current_value "$index" 4 >/dev/null; target_vtt[$index]=$ECV; fi
    done
}

refresh_inventory() {
    refresh_telemetry || return 1
    refresh_settings "${1-}"
}

SEL=''
selected_gpu_id() {
    if [[ $screen == settings ]]; then
        SEL=$active_gpu
        printf '%s' "$active_gpu"
        return
    fi
    SEL=${gpu_indices[$selected_gpu]-}
    printf '%s' "$SEL"
}

field_name() {
    case $selected_field in
        0) printf 'CORE' ;;
        1) printf 'MEMORY' ;;
        2) printf 'POWER' ;;
        3) printf 'FAN' ;;
        4) printf 'Core Offset(VTT)' ;;
        5) printf 'MEM LOCK' ;;
        6) printf 'APPLY' ;;
        7) printf 'RESET' ;;
    esac
}

FDV=0
field_delta_value() {
    local index=$1 field=$2 current target
    case $field in
        0) effective_current_value "$index" 0 >/dev/null; current=$ECV; target=${target_core[$index]-N/A} ;;
        1) effective_current_value "$index" 1 >/dev/null; current=$ECV; target=${target_memory[$index]-N/A} ;;
        2) effective_current_value "$index" 2 >/dev/null; current=$ECV; target=${target_power[$index]-N/A} ;;
        4) effective_current_value "$index" 4 >/dev/null; current=$ECV; target=${target_vtt[$index]-N/A} ;;
        *) return 1 ;;
    esac
    is_number "$current" || return 1
    is_number "$target" || return 1
    if [[ $current =~ ^-?[0-9]+$ && $target =~ ^-?[0-9]+$ ]]; then
        FDV=$((target - current))
        printf '%s' "$FDV"
    else
        FDV=$(awk -v c="$current" -v t="$target" 'BEGIN { printf "%.0f", t - c }')
        printf '%s' "$FDV"
    fi
}

FDD='-'
field_delta_display() {
    local index=$1 field=$2 delta unit current target
    if (( field == 1 )); then
        if memory_offset_target_locked "$index"; then FDD='-'; printf '-'; return; fi
        if memlocked "$index"; then FDD='on unlock'; printf '%s' "$FDD"; return; fi
    fi
    if (( field == 5 )); then
        current=$(effective_memlock "$index")
        target=${target_memlock[$index]-0}
        if [[ $current == "$target" ]]; then FDD='-'; else FDD="$(memlock_label "$current")->$(memlock_label "$target")"; fi
        printf '%s' "$FDD"
        return
    fi
    case $field in
        0|1) unit='MHz' ;;
        2) unit='W' ;;
        4) unit='mV' ;;
        3)
            effective_current_value "$index" 3 >/dev/null; current=$ECV
            target=${target_fan[$index]-}
            if [[ -z $target && $current == 0 ]]; then FDD='-'; printf '-'; return; fi
            if [[ -z $target ]]; then FDD='->AUTO'; printf '->AUTO'; return; fi
            if [[ $current == 0 ]]; then printf -v FDD 'AUTO->%s%%' "$target"; printf '%s' "$FDD"; return; fi
            if [[ $current == "$target" ]]; then FDD='-'; printf '-'; return; fi
            delta=$((target - current))
            if (( delta > 0 )); then printf -v FDD '+%s%%' "$delta"; else printf -v FDD '%s%%' "$delta"; fi
            printf '%s' "$FDD"
            return
            ;;
        *) FDD='-'; printf '-'; return ;;
    esac
    field_delta_value "$index" "$field" >/dev/null || { FDD='-'; printf '-'; return; }
    delta=$FDV
    if [[ $delta == 0 ]]; then
        FDD='-'
    elif [[ $delta == -* ]]; then
        printf -v FDD '%s %s' "$delta" "$unit"
    else
        printf -v FDD '+%s %s' "$delta" "$unit"
    fi
    printf '%s' "$FDD"
}

memlocked() {
    [[ $(effective_memlock "$1") != 0 ]]
}

effective_memlock() {
    local index=$1
    if [[ ${simulated_memlock[$index]+set} ]]; then
        printf '%s' "${simulated_memlock[$index]}"
    else
        printf '%s' "${memlock_speed[$index]-0}"
    fi
}

memlock_supported() {
    local index=$1 value=$2 speed
    [[ $value == 0 ]] && return 0
    for speed in ${memspd_choices[$index]-}; do
        [[ $speed == "$value" ]] && return 0
    done
    return 1
}

memlock_label() {
    local value=$1
    if [[ $value == 0 ]]; then printf 'DEFAULT'; else printf '%s MHz' "$value"; fi
}

memory_offset_target_locked() {
    [[ ${target_memlock[$1]-0} != 0 ]]
}

FCD=''
field_current_display() {
    local index=$1 field=$2 value
    case $field in
        0) effective_current_value "$index" 0 >/dev/null; fmt_offset "$ECV" >/dev/null; FCD=$FMT ;;
        1)
            if memlocked "$index"; then
                FCD='DISABLED'
            else
                effective_current_value "$index" 1 >/dev/null; fmt_offset "$ECV" >/dev/null; FCD=$FMT
            fi
            ;;
        2) effective_current_value "$index" 2 >/dev/null; fmt_watts "$ECV" >/dev/null; FCD=$FMT ;;
        3)
            effective_current_value "$index" 3 >/dev/null; value=$ECV
            if is_number "$value" && (( value > 0 )); then
                fmt_percent "$value" >/dev/null; FCD=$FMT
            else
                FCD='AUTO'
            fi
            ;;
        4) effective_current_value "$index" 4 >/dev/null; fmt_vtt "$ECV" >/dev/null; FCD=$FMT ;;
        5) FCD=$(memlock_label "$(effective_memlock "$index")") ;;
    esac
    printf '%s' "$FCD"
}

FTD=''
field_target_display() {
    local index=$1 field=$2 value
    case $field in
        0) fmt_offset "${target_core[$index]-N/A}" >/dev/null; FTD=$FMT ;;
        1)
            if memory_offset_target_locked "$index"; then
                FTD='DISABLED'
            else
                fmt_offset "${target_memory[$index]-N/A}" >/dev/null; FTD=$FMT
            fi
            ;;
        2) fmt_watts "${target_power[$index]-N/A}" >/dev/null; FTD=$FMT ;;
        3)
            value=${target_fan[$index]-}
            if [[ -n $value ]]; then
                fmt_percent "$value" >/dev/null; FTD=$FMT
            else
                FTD='AUTO'
            fi
            ;;
        4) fmt_vtt "${target_vtt[$index]-N/A}" >/dev/null; FTD=$FMT ;;
        5) FTD=$(memlock_label "${target_memlock[$index]-0}") ;;
    esac
    printf '%s' "$FTD"
}

field_is_pending() {
    local index=$1 field=$2 current target
    # A fixed target clock makes the offset irrelevant even before Apply.
    if (( field == 1 )) && memory_offset_target_locked "$index"; then return 1; fi
    case $field in
        0)
            effective_current_value "$index" 0 >/dev/null; current=$ECV
            target=${target_core[$index]-N/A}
            ;;
        1)
            effective_current_value "$index" 1 >/dev/null; current=$ECV
            target=${target_memory[$index]-N/A}
            ;;
        2)
            effective_current_value "$index" 2 >/dev/null; current=$ECV
            target=${target_power[$index]-N/A}
            ;;
        3)
            effective_current_value "$index" 3 >/dev/null; current=$ECV
            target=${target_fan[$index]-}
            if [[ -z $target ]]; then
                [[ -n ${dirty_fan[$index]+set} && $current != 0 ]] && return 0
                return 1
            fi
            [[ $current != "$target" ]]
            return $?
            ;;
        4)
            effective_current_value "$index" 4 >/dev/null; current=$ECV
            target=${target_vtt[$index]-N/A}
            ;;
        5)
            current=$(effective_memlock "$index")
            target=${target_memlock[$index]-0}
            ;;
    esac
    [[ $current != "$target" && $target != N/A ]]
}

PC=0
pending_count() {
    local index=$1 field count=0
    for field in 0 1 2 3 4 5; do
        field_is_pending "$index" "$field" && ((count++))
    done
    PC=$count
    printf '%s' "$count"
}

adjust_selected() {
    local index field=$selected_field delta=$1 value minimum maximum cap speed next
    index=$(selected_gpu_id)
    [[ -n $index ]] || return

    case $field in
        0)
            value=${target_core[$index]-}
            is_number "$value" || { set_notice 'Core offset is unavailable for this GPU.' "$yellow"; return; }
            cap=$(sane_core_max "$index")
            is_number "$cap" || cap=500
            value=$((value + delta * 25))
            (( value > cap )) && value=$cap
            (( value < -cap )) && value=-$cap
            target_core[$index]=$value
            dirty_core[$index]=1
            ;;
        1)
            if memory_offset_target_locked "$index"; then
                set_notice "MEMORY offset disabled by the fixed $(memlock_label "${target_memlock[$index]}") target." "$yellow"
                return
            fi
            value=${target_memory[$index]-}
            is_number "$value" || { set_notice 'Memory offset is unavailable for this GPU.' "$yellow"; return; }
            cap=$(sane_mem_max "$index")
            is_number "$cap" || cap=3000
            if (( cap == 0 )); then
                set_notice "Memory OC is locked on ${gpu_name[$index]} (HBM); target stays 0." "$yellow"
                return
            fi
            value=$((value + delta * 50))
            (( value > cap )) && value=$cap
            (( value < -cap )) && value=-$cap
            target_memory[$index]=$value
            dirty_memory[$index]=1
            ;;
        2)
            value=${target_power[$index]-}
            minimum=${gpu_power_min[$index]-}
            maximum=${gpu_power_max[$index]-}
            if ! is_number "$minimum" || ! is_number "$maximum"; then
                cap=$(sane_stock_watts "$index")
                minimum=$cap
                maximum=$cap
            fi
            if ! is_number "$value" || ! is_number "$minimum" || ! is_number "$maximum"; then
                set_notice 'Power-limit range is unavailable for this GPU.' "$yellow"
                return
            fi
            value=$((value + delta * 5))
            (( value < minimum )) && value=$minimum
            (( value > maximum )) && value=$maximum
            target_power[$index]=$value
            dirty_power[$index]=1
            ;;
        3)
            value=${target_fan[$index]-}
            if [[ -z $value ]]; then
                if (( delta > 0 )); then value=70; else value=20; fi
            else
                value=$((value + delta * 5))
                (( value < 20 )) && value=20
                (( value > 100 )) && value=100
            fi
            target_fan[$index]=$value
            dirty_fan[$index]=1
            ;;
        4)
            value=${target_vtt[$index]-}
            is_number "$value" || { set_notice 'VTT/GPU voltage offset is unavailable on this GPU or driver.' "$yellow"; return; }
            cap=$(sane_vtt_max "$index")
            is_number "$cap" || cap=50
            if (( cap == 0 )); then
                set_notice "VTT is locked on ${gpu_name[$index]}; target stays 0." "$yellow"
                return
            fi
            value=$((value + delta * 5))
            (( value > cap )) && value=$cap
            (( value < -cap )) && value=-$cap
            target_vtt[$index]=$value
            dirty_vtt[$index]=1
            ;;
        5)
            [[ -n ${memspd_choices[$index]-} ]] || { set_notice 'Fixed memory clock choices are unavailable for this GPU.' "$yellow"; return; }
            value=${target_memlock[$index]-0}
            next=$value
            if (( delta > 0 )); then
                for speed in ${memspd_choices[$index]}; do
                    if (( speed > value )); then next=$speed; break; fi
                done
            else
                next=0
                for speed in ${memspd_choices[$index]}; do
                    (( speed < value )) && next=$speed
                done
            fi
            target_memlock[$index]=$next
            if (( next > 0 )); then
                target_memory[$index]=$(effective_current_value "$index" 1)
                unset "dirty_memory[$index]"
            fi
            ;;
    esac
    case $field in
        0) field_is_pending "$index" 0 && dirty_core[$index]=1 || unset "dirty_core[$index]" ;;
        1) field_is_pending "$index" 1 && dirty_memory[$index]=1 || unset "dirty_memory[$index]" ;;
        2) field_is_pending "$index" 2 && dirty_power[$index]=1 || unset "dirty_power[$index]" ;;
        3) field_is_pending "$index" 3 && dirty_fan[$index]=1 || unset "dirty_fan[$index]" ;;
        4) field_is_pending "$index" 4 && dirty_vtt[$index]=1 || unset "dirty_vtt[$index]" ;;
        5) field_is_pending "$index" 5 && dirty_memlock[$index]=1 || unset "dirty_memlock[$index]" ;;
    esac
    set_notice "Pending $(field_name): $(field_target_display "$index" "$field") ($(field_delta_display "$index" "$field"))" "$yellow"
}

begin_numeric_entry() {
    local index value
    index=$(selected_gpu_id)
    if (( selected_field == 1 )) && memory_offset_target_locked "$index"; then
        set_notice "MEMORY offset disabled by the fixed $(memlock_label "${target_memlock[$index]}") target." "$yellow"
        return
    fi
    case $selected_field in
        0) value=${target_core[$index]-N/A} ;;
        1) value=${target_memory[$index]-N/A} ;;
        2) value=${target_power[$index]-N/A} ;;
        3) value=${target_fan[$index]-} ;;
        4) value=${target_vtt[$index]-N/A} ;;
        5) value=${target_memlock[$index]-0} ;;
    esac
    if [[ $selected_field != 3 ]] && ! is_number "$value"; then
        set_notice "$(field_name) is unavailable on this GPU." "$yellow"
        return
    fi
    numeric_entry=1
    numeric_buffer=$value
    numeric_replaced=0
    set_notice "Enter an exact integer for $(field_name); Enter accepts, Esc cancels." "$yellow"
}

commit_numeric_entry() {
    local index=$active_gpu number minimum maximum field=$selected_field cap
    if [[ ! $numeric_buffer =~ ^-?[0-9]+$ ]]; then
        set_notice 'Enter a whole number before accepting.' "$yellow"
        return 1
    fi
    if [[ $numeric_buffer == -* ]]; then
        number=$((-10#${numeric_buffer#-}))
    else
        number=$((10#$numeric_buffer))
    fi

    case $field in
        0)
            cap=$(sane_core_max "$index"); is_number "$cap" || cap=500
            (( number >= -cap && number <= cap )) || { set_notice "Core target must be between -$cap and +$cap MHz for ${gpu_name[$index]}." "$yellow"; return 1; }
            target_core[$index]=$number
            ;;
        1)
            if memory_offset_target_locked "$index"; then set_notice "MEMORY offset disabled by the fixed $(memlock_label "${target_memlock[$index]}") target." "$yellow"; return 1; fi
            cap=$(sane_mem_max "$index"); is_number "$cap" || cap=3000
            if (( cap == 0 )); then set_notice "Memory OC is locked on ${gpu_name[$index]}." "$yellow"; return 1; fi
            (( number >= -cap && number <= cap )) || { set_notice "Memory target must be between -$cap and +$cap MHz for ${gpu_name[$index]}." "$yellow"; return 1; }
            target_memory[$index]=$number
            ;;
        2)
            minimum=${gpu_power_min[$index]-N/A}
            maximum=${gpu_power_max[$index]-N/A}
            if ! is_number "$minimum" || ! is_number "$maximum"; then
                minimum=$(sane_stock_watts "$index")
                maximum=$minimum
            fi
            if ! is_number "$minimum" || ! is_number "$maximum" || \
                ! awk -v n="$number" -v min="$minimum" -v max="$maximum" 'BEGIN { exit !(n >= min && n <= max) }'; then
                set_notice "Power target must be within ${minimum}-${maximum} W." "$yellow"
                return 1
            fi
            target_power[$index]=$number
            ;;
        3)
            (( number >= 20 && number <= 100 )) || { set_notice 'Fan target must be between 20 and 100 percent.' "$yellow"; return 1; }
            target_fan[$index]=$number
            ;;
        4)
            cap=$(sane_vtt_max "$index"); is_number "$cap" || cap=50
            if (( cap == 0 )); then set_notice "VTT is locked on ${gpu_name[$index]}." "$yellow"; return 1; fi
            (( number >= -cap && number <= cap )) || { set_notice "VTT target must be between -$cap and +$cap mV." "$yellow"; return 1; }
            target_vtt[$index]=$number
            ;;
        5)
            if ! memlock_supported "$index" "$number"; then
                set_notice "${number} MHz is not an available fixed clock choice for ${gpu_name[$index]}." "$yellow"
                return 1
            fi
            target_memlock[$index]=$number
            if (( number > 0 )); then
                target_memory[$index]=$(effective_current_value "$index" 1)
                unset "dirty_memory[$index]"
            fi
            ;;
    esac

    case $field in
        0) field_is_pending "$index" 0 && dirty_core[$index]=1 || unset "dirty_core[$index]" ;;
        1) field_is_pending "$index" 1 && dirty_memory[$index]=1 || unset "dirty_memory[$index]" ;;
        2) field_is_pending "$index" 2 && dirty_power[$index]=1 || unset "dirty_power[$index]" ;;
        3) field_is_pending "$index" 3 && dirty_fan[$index]=1 || unset "dirty_fan[$index]" ;;
        4) field_is_pending "$index" 4 && dirty_vtt[$index]=1 || unset "dirty_vtt[$index]" ;;
        5) field_is_pending "$index" 5 && dirty_memlock[$index]=1 || unset "dirty_memlock[$index]" ;;
    esac
    numeric_entry=0
    numeric_buffer=''
    numeric_replaced=0
    set_notice "Staged $(field_name) target: $(field_target_display "$index" "$field"). Current value is unchanged until [Apply]." "$yellow"
}

adjust_numeric_entry() {
    local delta=$1 index=$active_gpu base step minimum maximum speed next
    if [[ $numeric_buffer =~ ^-?[0-9]+$ ]]; then
        base=$((10#${numeric_buffer#-}))
        [[ $numeric_buffer == -* ]] && base=$((-base))
    else
        case $selected_field in
            0) base=${target_core[$index]-N/A} ;;
            1) base=${target_memory[$index]-N/A} ;;
            2) base=${target_power[$index]-N/A} ;;
            3) base=${target_fan[$index]-} ;;
            4) base=${target_vtt[$index]-N/A} ;;
            5) base=${target_memlock[$index]-0} ;;
        esac
    fi

    if (( selected_field == 5 )); then
        [[ -n ${memspd_choices[$index]-} ]] || { set_notice 'Fixed memory clock choices are unavailable for this GPU.' "$yellow"; return; }
        is_number "$base" || base=0
        next=$base
        if (( delta > 0 )); then
            for speed in ${memspd_choices[$index]}; do
                if (( speed > base )); then next=$speed; break; fi
            done
        else
            next=0
            for speed in ${memspd_choices[$index]}; do
                (( speed < base )) && next=$speed
            done
        fi
        numeric_buffer=$next
        numeric_replaced=0
        set_notice "Exact MEM LOCK value: $(memlock_label "$next"); Enter accepts." "$yellow"
        return
    fi

    case $selected_field in
        0)
            step=25
            minimum=-$(sane_core_max "$index"); maximum=$(sane_core_max "$index")
            is_number "$minimum" || minimum=-500
            is_number "$maximum" || maximum=500
            ;;
        1)
            step=50
            minimum=-$(sane_mem_max "$index"); maximum=$(sane_mem_max "$index")
            is_number "$minimum" || minimum=-3000
            is_number "$maximum" || maximum=3000
            ;;
        2)
            step=5
            minimum=${gpu_power_min[$index]-N/A}
            maximum=${gpu_power_max[$index]-N/A}
            if ! is_number "$minimum" || ! is_number "$maximum"; then
                minimum=$(sane_stock_watts "$index")
                maximum=$minimum
            fi
            ;;
        3)
            step=5; minimum=20; maximum=100
            if ! is_number "$base"; then
                if (( delta > 0 )); then base=65; else base=25; fi
            fi
            ;;
        4)
            step=5
            minimum=-$(sane_vtt_max "$index"); maximum=$(sane_vtt_max "$index")
            is_number "$minimum" || minimum=-50
            is_number "$maximum" || maximum=50
            ;;
        5)
            step=405; minimum=0; maximum=${memspd_max[$index]-0}
            ;;
    esac

    is_number "$base" || { set_notice "$(field_name) target is unavailable." "$yellow"; return; }
    if [[ $selected_field == 2 ]] && { ! is_number "$minimum" || ! is_number "$maximum"; }; then
        set_notice 'Power-limit range is unavailable for this GPU.' "$yellow"
        return
    fi
    base=$((base + delta * step))
    (( base < minimum )) && base=$minimum
    (( base > maximum )) && base=$maximum
    numeric_buffer=$base
    numeric_replaced=0
    set_notice "Exact $(field_name) value: ${numeric_buffer}; Enter accepts." "$yellow"
}

handle_numeric_entry_key() {
    local key=$1
    case $key in
        ENTER)
            commit_numeric_entry
            ;;
        ESC)
            numeric_entry=0
            numeric_buffer=''
            numeric_replaced=0
            set_notice 'Number entry cancelled.' "$dim"
            ;;
        BACKSPACE)
            numeric_buffer=${numeric_buffer%?}
            numeric_replaced=1
            ;;
        LEFT|h)
            adjust_numeric_entry -1
            ;;
        RIGHT|l)
            adjust_numeric_entry 1
            ;;
        -)
            if (( ! numeric_replaced )); then numeric_buffer=''; numeric_replaced=1; fi
            [[ -z $numeric_buffer ]] && numeric_buffer='-'
            ;;
        [0-9])
            if (( ! numeric_replaced )); then numeric_buffer=''; numeric_replaced=1; fi
            ((${#numeric_buffer} < 8)) && numeric_buffer+=$key
            ;;
    esac
}

discard_selected() {
    local index field=$selected_field
    index=$(selected_gpu_id)
    [[ -n $index ]] || return
    if (( field >= 6 )); then
        set_notice 'Select a setting row to discard its target.' "$dim"
        return
    fi
    case $field in
        0) target_core[$index]=$(effective_current_value "$index" 0); unset "dirty_core[$index]" ;;
        1) target_memory[$index]=$(effective_current_value "$index" 1); unset "dirty_memory[$index]" ;;
        2) target_power[$index]=$(effective_current_value "$index" 2); unset "dirty_power[$index]" ;;
        3)
            target_fan[$index]=$(effective_fan_target "$index")
            unset "dirty_fan[$index]"
            ;;
        4) target_vtt[$index]=$(effective_current_value "$index" 4); unset "dirty_vtt[$index]" ;;
        5) target_memlock[$index]=$(effective_memlock "$index"); unset "dirty_memlock[$index]" ;;
    esac
    set_notice "Discarded $(field_name) change." "$dim"
}

discard_all_pending() {
    local index=$1
    target_core[$index]=$(effective_current_value "$index" 0)
    target_memory[$index]=$(effective_current_value "$index" 1)
    target_power[$index]=$(effective_current_value "$index" 2)
    target_vtt[$index]=$(effective_current_value "$index" 4)
    target_fan[$index]=$(effective_fan_target "$index")
    target_memlock[$index]=$(effective_memlock "$index")
    unset "dirty_core[$index]" "dirty_memory[$index]" "dirty_vtt[$index]" "dirty_power[$index]" "dirty_fan[$index]" "dirty_memlock[$index]"
}

choose_unsaved_action() {
    local key
    printf '\033[?25h\n%sUnsaved changes: [a]pply, [d]iscard, or [c]ancel? %s' "$yellow" "$reset" >&2
    IFS= read -r -s -n1 key
    printf '\033[?25l\n' >&2
    case $key in
        a|A) printf 'apply' ;;
        d|D) printf 'discard' ;;
        c|C|$'\e'|*) printf 'cancel' ;;
    esac
}

leave_settings() {
    local destination=${1:-picker} index action pending apply_status
    index=$(selected_gpu_id)
    [[ -n $index ]] || return 1
    pending=$(pending_count "$index")
    if (( pending > 0 )); then
        action=$(choose_unsaved_action)
        case $action in
            apply)
                apply_pending 1
                apply_status=$?
                if (( apply_status != 0 )); then
                    return 1
                fi
                (( $(pending_count "$index") == 0 )) || return 1
                ;;
            discard)
                discard_all_pending "$index"
                set_notice 'Discarded pending changes.' "$dim"
                ;;
            *)
                set_notice 'Stayed in GPU settings.' "$dim"
                return 1
                ;;
        esac
    fi

    if [[ $destination == quit ]]; then
        exit 0
    fi
    screen='picker'
    active_gpu=''
    set_notice "Returned to GPU list." "$dim"
    return 0
}

confirm_action() {
    local prompt=$1 key
    printf '\033[?25h\n%s%s%s  [y/N] ' "$yellow" "$prompt" "$reset"
    IFS= read -r -s -n1 key
    printf '\033[?25l'
    [[ $key == y || $key == Y ]]
}

apply_pending() {
    local index pending skip_confirm=${1:-0}
    index=$(selected_gpu_id)
    [[ -n $index ]] || return
    pending=$(pending_count "$index")
    if (( pending == 0 )); then
        set_notice 'There are no pending changes to apply.' "$dim"
        return
    fi
    if (( ! skip_confirm )) && ! confirm_action "Apply ${pending} pending change(s) to GPU ${index}?"; then
        set_notice 'Apply cancelled.' "$dim"
        return 1
    fi

    if (( dry_run )); then
        set_notice "Preview only: GPU ${index} targets were not committed. Hardware writes are disabled." "$green"
        return 2
    fi

    field_is_pending "$index" 0 && simulated_core[$index]=${target_core[$index]}
    field_is_pending "$index" 1 && simulated_memory[$index]=${target_memory[$index]}
    field_is_pending "$index" 2 && simulated_power[$index]=${target_power[$index]}
    field_is_pending "$index" 3 && simulated_fan[$index]=${target_fan[$index]}
    field_is_pending "$index" 4 && simulated_vtt[$index]=${target_vtt[$index]}
    field_is_pending "$index" 5 && simulated_memlock[$index]=${target_memlock[$index]}
    unset "dirty_core[$index]" "dirty_memory[$index]" "dirty_vtt[$index]" "dirty_power[$index]" "dirty_fan[$index]" "dirty_memlock[$index]"
    refresh_telemetry >/dev/null || true
    # Rebase non-dirty targets on the new simulated-applied values (no slow queries).
    if [[ -z ${dirty_core[$index]+set} ]]; then target_core[$index]=$(effective_current_value "$index" 0); fi
    if [[ -z ${dirty_memory[$index]+set} ]]; then target_memory[$index]=$(effective_current_value "$index" 1); fi
    if [[ -z ${dirty_power[$index]+set} ]]; then target_power[$index]=$(effective_current_value "$index" 2); fi
    if [[ -z ${dirty_fan[$index]+set} ]]; then target_fan[$index]=$(effective_fan_target "$index"); fi
    if [[ -z ${dirty_vtt[$index]+set} ]]; then target_vtt[$index]=$(effective_current_value "$index" 4); fi
    if [[ -z ${dirty_memlock[$index]+set} ]]; then target_memlock[$index]=$(effective_memlock "$index"); fi
    set_notice "Simulated apply complete for GPU ${index}. Hardware unchanged." "$green"
    return 0
}

reset_selected() {
    local index stock
    index=$(selected_gpu_id)
    [[ -n $index ]] || return

    if is_number "$(effective_current_value "$index" 0)"; then target_core[$index]=0; fi
    if is_number "$(effective_current_value "$index" 1)"; then target_memory[$index]=0; fi
    if is_number "${gpu_power_default[$index]-}"; then
        target_power[$index]=${gpu_power_default[$index]}
    else
        stock=$(sane_stock_watts "$index")
        if is_number "$stock"; then target_power[$index]=$stock; fi
    fi
    if is_number "$(effective_current_value "$index" 4)"; then target_vtt[$index]=0; fi
    target_memlock[$index]=0
    target_fan[$index]=''

    field_is_pending "$index" 0 && dirty_core[$index]=1 || unset "dirty_core[$index]"
    field_is_pending "$index" 1 && dirty_memory[$index]=1 || unset "dirty_memory[$index]"
    field_is_pending "$index" 2 && dirty_power[$index]=1 || unset "dirty_power[$index]"
    if [[ -n ${target_fan[$index]-} ]]; then
        field_is_pending "$index" 3 && dirty_fan[$index]=1 || unset "dirty_fan[$index]"
    else
        [[ $(effective_current_value "$index" 3) != 0 ]] && dirty_fan[$index]=1 || unset "dirty_fan[$index]"
    fi
    field_is_pending "$index" 4 && dirty_vtt[$index]=1 || unset "dirty_vtt[$index]"
    field_is_pending "$index" 5 && dirty_memlock[$index]=1 || unset "dirty_memlock[$index]"
    set_notice "Stock targets staged for GPU ${index}, including an unlocked memory clock. Select [Apply] to commit." "$yellow"
}

reset_all_gpus() {
    local index count=0
    for index in "${gpu_indices[@]}"; do
        if is_number "$(effective_current_value "$index" 0)"; then target_core[$index]=0; dirty_core[$index]=1; fi
        if is_number "$(effective_current_value "$index" 1)"; then target_memory[$index]=0; dirty_memory[$index]=1; fi
        if is_number "${gpu_power_default[$index]-}"; then target_power[$index]=${gpu_power_default[$index]}; dirty_power[$index]=1; fi
        if is_number "$(effective_current_value "$index" 4)"; then target_vtt[$index]=0; dirty_vtt[$index]=1; fi
        target_memlock[$index]=0
        target_fan[$index]=''
        [[ $(effective_current_value "$index" 3) != 0 ]] && dirty_fan[$index]=1 || unset "dirty_fan[$index]"
        # Re-evaluate pending so already-stock GPUs don't stay dirty.
        field_is_pending "$index" 0 && dirty_core[$index]=1 || unset "dirty_core[$index]"
        field_is_pending "$index" 1 && dirty_memory[$index]=1 || unset "dirty_memory[$index]"
        field_is_pending "$index" 2 && dirty_power[$index]=1 || unset "dirty_power[$index]"
        field_is_pending "$index" 4 && dirty_vtt[$index]=1 || unset "dirty_vtt[$index]"
        field_is_pending "$index" 5 && dirty_memlock[$index]=1 || unset "dirty_memlock[$index]"
        ((count++))
    done
    set_notice "Stock targets staged for all ${count} GPU(s). Select [Apply] per GPU to commit." "$yellow"
}

save_file_path() {
    printf '%s/gpuoc/tui-save' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

# Save the applied setup (effective values, simulated where applied).
# Only allowed when nothing is still staged: the save must reflect a clean,
# fully-applied state.
save_plan() {
    local index file dir core mem power fan vtt memlock total
    for index in "${gpu_indices[@]}"; do
        pending_count "$index" >/dev/null
        if (( PC > 0 )); then
            set_notice "GPU ${index} still has ${PC} staged change(s); Apply or discard everything before saving." "$yellow"
            return 1
        fi
    done
    file=$(save_file_path)
    dir=${file%/*}
    mkdir -p "$dir" 2>/dev/null || { set_notice "Cannot create ${dir}." "$red"; return 1; }
    {
        printf '# gpuoc-tui save v2 %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf 'unknown')"
        for index in "${gpu_indices[@]}"; do
            effective_current_value "$index" 0 >/dev/null; core=$ECV
            effective_current_value "$index" 1 >/dev/null; mem=$ECV
            effective_current_value "$index" 2 >/dev/null; power=$ECV
            effective_fan_target "$index" >/dev/null
            if [[ -n $EFT ]]; then fan=$EFT; else fan=AUTO; fi
            effective_current_value "$index" 4 >/dev/null; vtt=$ECV
            memlock=$(effective_memlock "$index")
            printf 'GPU %s %s core=%s mem=%s power=%s fan=%s vtt=%s memlock=%s\n' \
                "$index" "${gpu_bus[$index]-unknown}" "$core" "$mem" "$power" "$fan" "$vtt" "$memlock"
        done
    } > "$file" || { set_notice "Cannot write ${file}." "$red"; return 1; }
    total=${#gpu_indices[@]}
    set_notice "Saved ${total} GPU(s) to ${file}." "$green"
}

# Stage a saved setup as pending targets (review + Apply, never applied
# directly). Asks first when the current plan has staged changes.
load_plan() {
    local file line index bus core mem power fan vtt memlock staged=0 matched=0 skipped=0 pending_total=0
    file=$(save_file_path)
    [[ -f $file ]] || { set_notice 'No save found yet; press s once everything is applied.' "$dim"; return 1; }
    for index in "${gpu_indices[@]}"; do
        pending_count "$index" >/dev/null
        (( pending_total += PC ))
    done
    if (( pending_total > 0 )); then
        confirm_action "Load save and replace ${pending_total} staged change(s)?" \
            || { set_notice 'Load cancelled.' "$dim"; return 1; }
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^GPU\ [0-9]+\ ([^[:space:]]+)\ core=([^[:space:]]+)\ mem=([^[:space:]]+)\ power=([^[:space:]]+)\ fan=([^[:space:]]+)\ vtt=([^[:space:]]+)(\ memlock=([0-9]+))?$ ]] || continue
        bus=${BASH_REMATCH[1]}; core=${BASH_REMATCH[2]}; mem=${BASH_REMATCH[3]}
        power=${BASH_REMATCH[4]}; fan=${BASH_REMATCH[5]}; vtt=${BASH_REMATCH[6]}; memlock=${BASH_REMATCH[8]-}
        index=''
        for index in "${gpu_indices[@]}"; do
            [[ ${gpu_bus[$index]-} == "$bus" ]] && break
            index=''
        done
        [[ -n $index ]] || { ((skipped++)); continue; }
        ((matched++))
        if is_number "$core" || [[ $core == N/A ]]; then target_core[$index]=$core; fi
        if is_number "$mem" || [[ $mem == N/A ]]; then target_memory[$index]=$mem; fi
        if is_number "$power" || [[ $power == N/A ]]; then target_power[$index]=$power; fi
        if [[ $fan == AUTO ]]; then
            target_fan[$index]=''
        elif is_number "$fan"; then
            target_fan[$index]=$fan
        fi
        if is_number "$vtt" || [[ $vtt == N/A ]]; then target_vtt[$index]=$vtt; fi
        if [[ -n $memlock ]] && memlock_supported "$index" "$memlock"; then
            target_memlock[$index]=$memlock
            if (( memlock > 0 )); then target_memory[$index]=$(effective_current_value "$index" 1); fi
        fi
        field_is_pending "$index" 0 && dirty_core[$index]=1 || unset "dirty_core[$index]"
        field_is_pending "$index" 1 && dirty_memory[$index]=1 || unset "dirty_memory[$index]"
        field_is_pending "$index" 2 && dirty_power[$index]=1 || unset "dirty_power[$index]"
        if [[ -n ${target_fan[$index]-} ]]; then
            field_is_pending "$index" 3 && dirty_fan[$index]=1 || unset "dirty_fan[$index]"
        else
            effective_current_value "$index" 3 >/dev/null
            [[ $ECV != 0 ]] && dirty_fan[$index]=1 || unset "dirty_fan[$index]"
        fi
        field_is_pending "$index" 4 && dirty_vtt[$index]=1 || unset "dirty_vtt[$index]"
        field_is_pending "$index" 5 && dirty_memlock[$index]=1 || unset "dirty_memlock[$index]"
    done < "$file"
    for index in "${gpu_indices[@]}"; do
        pending_count "$index" >/dev/null
        (( staged += PC ))
    done
    if (( skipped > 0 )); then
        set_notice "Loaded save: ${matched} GPU(s), ${skipped} missing, ${staged} staged. Apply to commit." "$yellow"
    else
        set_notice "Loaded save: ${matched} GPU(s), ${staged} staged. Apply to commit." "$yellow"
    fi
}

# Stock-reset a single selected row (staged for review, not applied).
reset_field_to_stock() {
    local index field=$selected_field stock
    index=$(selected_gpu_id)
    [[ -n $index ]] || return
    case $field in
        0)
            effective_current_value "$index" 0 >/dev/null
            is_number "$ECV" || { set_notice 'CORE is unavailable on this GPU.' "$yellow"; return; }
            target_core[$index]=0
            field_is_pending "$index" 0 && dirty_core[$index]=1 || unset "dirty_core[$index]"
            ;;
        1)
            if memory_offset_target_locked "$index"; then
                set_notice "MEMORY offset disabled by the fixed $(memlock_label "${target_memlock[$index]}") target." "$yellow"
                return
            fi
            effective_current_value "$index" 1 >/dev/null
            is_number "$ECV" || { set_notice 'MEMORY is unavailable on this GPU.' "$yellow"; return; }
            target_memory[$index]=0
            field_is_pending "$index" 1 && dirty_memory[$index]=1 || unset "dirty_memory[$index]"
            ;;
        2)
            if is_number "${gpu_power_default[$index]-}"; then
                target_power[$index]=${gpu_power_default[$index]}
            else
                stock=$(sane_stock_watts "$index")
                is_number "$stock" || { set_notice 'Power range is unavailable on this GPU.' "$yellow"; return; }
                target_power[$index]=$stock
            fi
            field_is_pending "$index" 2 && dirty_power[$index]=1 || unset "dirty_power[$index]"
            ;;
        3)
            target_fan[$index]=''
            effective_current_value "$index" 3 >/dev/null
            [[ $ECV != 0 ]] && dirty_fan[$index]=1 || unset "dirty_fan[$index]"
            ;;
        4)
            effective_current_value "$index" 4 >/dev/null
            is_number "$ECV" || { set_notice 'VTT is unavailable on this GPU or driver.' "$yellow"; return; }
            target_vtt[$index]=0
            field_is_pending "$index" 4 && dirty_vtt[$index]=1 || unset "dirty_vtt[$index]"
            ;;
        5)
            target_memlock[$index]=0
            field_is_pending "$index" 5 && dirty_memlock[$index]=1 || unset "dirty_memlock[$index]"
            ;;
        *)
            reset_selected
            return
            ;;
    esac
    field_target_display "$index" "$field" >/dev/null
    set_notice "Stock staged for $(field_name): $FTD. Select [Apply] to commit." "$yellow"
}

# ASCII slider: '-' track, 'S' = stock/default, 'X' = staged target,
# '*' = target sitting on default. Bipolar (core/mem/vtt): S at 0 centered.
# Power: S at stock default inside driver [min,max]. Fan numeric: X on the
# 20-100 track (stock is AUTO, off-scale, so no S). All ASCII.
# Reads per-GPU caps from $CAP_CORE/$CAP_MEM/$CAP_VTT/$CAP_STOCK, which the
# caller (draw_control) resolves once per row via caps_for_index.
SLD=''
slider_for_field() {
    local index=$1 field=$2 width=${3-60} pos defpos i out='' target minimum maximum default cap nodefault=0
    is_number "$width" || width=60
    (( width < 12 )) && width=12
    (( width > 80 )) && width=80
    case $field in
        0)
            target=${target_core[$index]-N/A}
            cap=$CAP_CORE; is_number "$cap" || cap=500
            minimum=-$cap; maximum=$cap; default=0
            ;;
        1)
            target=${target_memory[$index]-N/A}
            if memory_offset_target_locked "$index"; then SLD="[ disabled @ ${target_memlock[$index]} MHz ]"; printf '%s' "$SLD"; return; fi
            cap=$CAP_MEM; is_number "$cap" || cap=3000
            if (( cap == 0 )); then SLD='[     locked      ]'; printf '%s' "$SLD"; return; fi
            minimum=-$cap; maximum=$cap; default=0
            ;;
        2)
            target=${target_power[$index]-N/A}
            minimum=${gpu_power_min[$index]-N/A}
            maximum=${gpu_power_max[$index]-N/A}
            default=${gpu_power_default[$index]-N/A}
            if ! is_number "$minimum" || ! is_number "$maximum"; then
                default=$CAP_STOCK
                minimum=$default; maximum=$default
            fi
            if ! is_number "$default"; then default=$minimum; fi
            ;;
        3)
            target=${target_fan[$index]-}
            if [[ -z $target ]]; then SLD='[      AUTO       ]'; printf '%s' "$SLD"; return; fi
            minimum=20; maximum=100; default=20; nodefault=1
            ;;
        4)
            target=${target_vtt[$index]-N/A}
            cap=$CAP_VTT; is_number "$cap" || cap=50
            if (( cap == 0 )); then SLD='[     locked      ]'; printf '%s' "$SLD"; return; fi
            minimum=-$cap; maximum=$cap; default=0
            ;;
        5)
            target=${target_memlock[$index]-0}
            minimum=0; default=0
            maximum=0
            for cap in ${memspd_choices[$index]-}; do maximum=$cap; done
            ;;
    esac
    is_number "$target" || { SLD='[       N/A       ]'; printf '%s' "$SLD"; return; }
    is_number "$minimum" || { SLD='[       N/A       ]'; printf '%s' "$SLD"; return; }
    is_number "$maximum" || { SLD='[       N/A       ]'; printf '%s' "$SLD"; return; }
    if (( maximum <= minimum )); then SLD='[       N/A       ]'; printf '%s' "$SLD"; return; fi
    (( target < minimum )) && target=$minimum
    (( target > maximum )) && target=$maximum
    (( default < minimum )) && default=$minimum
    (( default > maximum )) && default=$maximum
    pos=$(( (target - minimum) * (width - 1) / (maximum - minimum) ))
    defpos=$(( (default - minimum) * (width - 1) / (maximum - minimum) ))
    (( pos < 0 )) && pos=0
    (( pos >= width )) && pos=$((width - 1))
    (( defpos < 0 )) && defpos=0
    (( defpos >= width )) && defpos=$((width - 1))
    for (( i = 0; i < width; i++ )); do
        if (( nodefault == 0 && i == pos && i == defpos )); then
            out+='*'
        elif (( i == pos )); then
            out+='X'
        elif (( nodefault == 0 && i == defpos )); then
            out+='S'
        else
            out+='-'
        fi
    done
    printf -v SLD '[%s]' "$out"
    printf '%s' "$SLD"
}

LIM=''
limit_for_field() {
    local index=$1 field=$2 cap pmin pmax
    case $field in
        0) cap=$CAP_CORE; printf -v LIM '[+/-%s]' "$cap" ;;
        1)
            if memory_offset_target_locked "$index"; then
                LIM='[fixed clock]'
            else
                cap=$CAP_MEM
                if (( cap == 0 )); then LIM='[locked]'; else printf -v LIM '[+/-%s]' "$cap"; fi
            fi
            ;;
        2)
            pmin=${gpu_power_min[$index]-N/A}
            pmax=${gpu_power_max[$index]-N/A}
            if is_number "$pmin" && is_number "$pmax"; then
                printf -v LIM '[%s-%sW]' "$pmin" "$pmax"
            else
                printf -v LIM '[%sW]' "$CAP_STOCK"
            fi
            ;;
        3) LIM='[20-100]' ;;
        4)
            effective_current_value "$index" 4 >/dev/null
            if ! is_number "$ECV"; then
                LIM='[UNSUPPORTED]'
            else
                cap=$CAP_VTT
                if (( cap == 0 )); then LIM='[locked]'; else printf -v LIM '[+/-%s]' "$cap"; fi
            fi
            ;;
        5)
            if [[ -n ${memspd_choices[$index]-} ]]; then
                LIM="[DEFAULT,${memspd_choices[$index]// /,}]"
            else
                LIM='[DEFAULT only]'
            fi
            ;;
    esac
    printf '%s' "$LIM"
}

STP=''
step_for_field() {
    local index=$1 field=$2
    if (( field == 1 )) && memory_offset_target_locked "$index"; then STP='disabled'; printf '%s' "$STP"; return; fi
    case $field in
        0) STP='+/-25' ;;
        1) STP='+/-50' ;;
        2) STP='+/-5W' ;;
        3) STP='+/-5%' ;;
        4) STP='+/-5mV' ;;
        5) STP='supported' ;;
    esac
    printf '%s' "$STP"
}

draw_control() {
    local index=$1 field=$2 label current target delta slider limit step color marker sw
    case $field in
        0) label='CORE' ;;
        1) label='MEMORY' ;;
        2) label='POWER' ;;
        3) label='FAN' ;;
        4) label='Core Offset(VTT)' ;;
        5) label='MEM LOCK' ;;
    esac
    caps_for_index "$index"
    field_current_display "$index" "$field" >/dev/null; current=$FCD
    field_target_display "$index" "$field" >/dev/null; target=$FTD
    field_delta_display "$index" "$field" >/dev/null; delta=$FDD
    limit_for_field "$index" "$field" >/dev/null; limit=$LIM
    step_for_field "$index" "$field" >/dev/null; step=$STP
    sw=$((TERM_W - 20))
    (( sw < 20 )) && sw=20
    (( sw > 60 )) && sw=60
    slider_for_field "$index" "$field" "$sw" >/dev/null; slider=$SLD
    marker=' '
    color="$cyan"
    if [[ $screen != picker ]] && (( selected_field == field )); then
        marker='>'
        color="$magenta"
    fi
    if [[ $screen == picker ]]; then
        color="$dim"
    fi
    if field_is_pending "$index" "$field"; then
        target="${yellow}${target}${reset}"
        delta="${yellow}${delta}${reset}"
    else
        delta="${dim}${delta}${reset}"
    fi
    printf '    %s%s %-16s%s  cur %-9s  tgt %-9s  (%-9s)  %s\n' \
        "$color" "$marker" "$label" "$reset" "$current" "$target" "$delta" "$limit"
    printf '      %s%s%s  %s\n' "$color" "$slider" "$reset" "$step"
}

