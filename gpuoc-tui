        *'5060'*) printf '405:14001'; return ;;
        *'5050'*) printf '405:10001'; return ;;
        *'4090'*) printf '405:10501'; return ;;
        *'4080 SUPER'*|*'4080S'*) printf '405:11201'; return ;;
        *'4080'*) printf '405:11201'; return ;;
        *'4070 TI SUPER'*|*'4070 TIS'*) printf '405:10501'; return ;;
        *'4070 TI'*|*'4070TI'*) printf '405:10501'; return ;;
        *'4070 SUPER'*) printf '405:10501'; return ;;
        *'4070'*) printf '405:10501'; return ;;
        *'4060 TI'*|*'4060TI'*) printf '405:9001'; return ;;
        *'4060'*) printf '405:8501'; return ;;
        *'3090 TI'*|*'3090TI'*) printf '405:10501'; return ;;
        *'3090'*) printf '405:9751'; return ;;
        *'3080 TI'*|*'3080TI'*) printf '405:9501'; return ;;
        *'3080 12GB'*|*'3080 12'*) printf '405:9501'; return ;;
        *'3080'*) printf '405:9501'; return ;;
