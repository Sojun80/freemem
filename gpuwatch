#!/usr/bin/env bash
# gpuwatch - live NVIDIA GPU settings and telemetry watcher.
#
# This intentionally focuses on the GPU itself: temperatures, power, memory,
# clocks, and driver-exposed overclock settings. It does not list processes.

set -u

LC_ALL=C
export LC_ALL

gpuwatch_version='1.0'
interval=1
gpu_filter=''
once=0
positional_refresh_rate=0
declare -A nvml_core_offsets=()
declare -A nvml_memory_offsets=()

if [[ -t 1 ]]; then
    cyan=$'\033[36m'
    green=$'\033[32m'
    yellow=$'\033[33m'
    red=$'\033[31m'
    dim=$'\033[2m'
    reset=$'\033[0m'
    show_cursor=$'\033[?25h'
else
    cyan=''
    green=''
    yellow=''
    red=''
    dim=''
    reset=''
    show_cursor=''
fi

usage() {
    cat <<EOF
Usage: ${0##*/} [REFRESH_RATE] [OPTIONS]

Live NVIDIA GPU settings and telemetry watcher.

Argument:
  REFRESH_RATE             Refresh rate in seconds (for example: 1, 1.0, .5)

Options:
  -r, --refresh-rate SEC   Refresh rate in seconds (default: 1)
  -i, --interval SEC       Alias for --refresh-rate
  -g, --gpu INDEX         Show only one nvidia-smi GPU index
  -1, --once              Print one snapshot and exit
  -h, --help              Show this help

Displayed values include GPU and memory temperature, power draw and limit,
VRAM usage, utilization, current/max performance-level graphics and memory
clocks, fan speed, P-state, and core/memory clock offsets from NVML or
nvidia-settings when available.

Press Ctrl-C to exit live mode.
EOF
}

die() {
    printf '%s\n' "$*" >&2
    exit 2
}

trim() {
    local value=${1-}
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

is_number() {
    [[ ${1-} =~ ^[0-9]+([.][0-9]+)?$ ]]
}

fmt_mem() {
    local value=${1-}
    if ! is_number "$value"; then
        printf '%s' "${value:-N/A}"
        return
    fi
    awk -v m="$value" 'BEGIN {
        if (m >= 1024 * 1024) printf "%.2f TiB", m / (1024 * 1024)
        else if (m >= 1024) printf "%.2f GiB", m / 1024
        else printf "%.0f MiB", m
    }'
}

fmt_watts() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.2f W' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_mhz() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.0f MHz' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_offset() {
    local value=${1-}
    if ! is_number "$value" && [[ ! $value =~ ^-[0-9]+([.][0-9]+)?$ ]]; then
        printf '%s' "${value:-N/A}"
    elif [[ $value == -* ]]; then
        printf '%s MHz' "$value"
    else
        printf '+%s MHz' "$value"
    fi
}

fmt_temp() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.0f°C' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_percent() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.0f%%' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_integer() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.0f' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_offset_short() {
    local value=${1-}
    if ! is_number "$value" && [[ ! $value =~ ^-[0-9]+([.][0-9]+)?$ ]]; then
        printf '%s' "${value:-N/A}"
    elif [[ $value == -* ]]; then
        printf '%s' "$value"
    else
        printf '+%s' "$value"
    fi
}

fmt_temp_field() {
    local value=${1-}
    if is_number "$value"; then
        printf '%3.0f°C' "$value"
    else
        printf '%4s' "${value:-N/A}"
    fi
}

fmt_temp_compact() {
    local value=${1-}
    if is_number "$value"; then
        printf '%3.0fc' "$value"
    else
        printf '%4s' "${value:-N/A}"
    fi
}

temp_field() {
    local value=${1-}
    local field
    field=$(fmt_temp_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v t="$value" 'BEGIN { exit !(t > 82) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v t="$value" 'BEGIN { exit !(t > 75) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

memory_temp_field() {
    local value=${1-}
    local field
    field=$(fmt_temp_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v t="$value" 'BEGIN { exit !(t > 95) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v t="$value" 'BEGIN { exit !(t > 85) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

temp_compact_field() {
    local value=${1-}
    local warning=${2-75} critical=${3-82}
    local field
    field=$(fmt_temp_compact "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v t="$value" -v limit="$critical" 'BEGIN { exit !(t > limit) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v t="$value" -v limit="$warning" 'BEGIN { exit !(t > limit) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

fmt_percent_field() {
    local value=${1-}
    if is_number "$value"; then
        printf '%3.0f%%' "$value"
    else
        printf '%3s' "${value:-N/A}"
    fi
}

fan_field() {
    local value=${1-}
    local field
    field=$(fmt_percent_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v f="$value" 'BEGIN { exit !(f > 80) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

fmt_gib_field() {
    local value=${1-}
    if is_number "$value"; then
        awk -v m="$value" 'BEGIN { printf "%5.2f", m / 1024 }'
    else
        printf '%5s' "${value:-N/A}"
    fi
}

fmt_power_pair() {
    local draw=${1-} limit=${2-}
    local draw_field limit_field
    draw_field=$(fmt_integer "$draw")
    limit_field=$(fmt_integer "$limit")
    printf '%3s/%3sW' "$draw_field" "$limit_field"
}

fmt_clock_pair() {
    local current=${1-} maximum=${2-}
    # Reserve room for five-digit memory clocks such as 13801 on both clock
    # fields, keeping GCLK and MCLK columns aligned as frequencies change.
    printf '%5s/%5s' "$(fmt_integer "$current")" "$(fmt_integer "$maximum")"
}

util_field() {
    local value=${1-}
    local field
    field=$(fmt_percent_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

capacity_field() {
    local value=${1-}
    local field
    field=$(fmt_percent_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v u="$value" 'BEGIN { exit !(u >= 90) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v u="$value" 'BEGIN { exit !(u >= 70) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

capacity_compact_field() {
    local value=${1-}
    local field
    if is_number "$value"; then
        field=$(printf '%3.0f%%' "$value")
    else
        field=$(printf '%4s' "${value:-N/A}")
    fi
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v u="$value" 'BEGIN { exit !(u >= 90) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v u="$value" 'BEGIN { exit !(u >= 70) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

memory_percent() {
    local used=${1-} total=${2-}
    if is_number "$used" && is_number "$total" && [[ $total != 0 ]]; then
        awk -v u="$used" -v t="$total" 'BEGIN { printf "%.0f", (u / t) * 100 }'
    else
        printf 'N/A'
    fi
}

nvml_offsets_for_gpus() {
    nvml_core_offsets=()
    nvml_memory_offsets=()
    command -v python3 >/dev/null 2>&1 || return

    while IFS=$'\t' read -r index core_offset memory_offset; do
        [[ $index =~ ^[0-9]+$ ]] || continue
        [[ $core_offset =~ ^-?[0-9]+$ ]] && nvml_core_offsets[$index]=$core_offset
        [[ $memory_offset =~ ^-?[0-9]+$ ]] && nvml_memory_offsets[$index]=$memory_offset
    done < <(
        python3 - <<'PY' 2>/dev/null
import ctypes

try:
    nvml = ctypes.CDLL("libnvidia-ml.so.1")
    nvml_init = nvml.nvmlInit_v2
    nvml_shutdown = nvml.nvmlShutdown
    get_count = nvml.nvmlDeviceGetCount_v2
    get_handle = nvml.nvmlDeviceGetHandleByIndex_v2
except (AttributeError, OSError):
    raise SystemExit(0)

nvml_init.restype = ctypes.c_int
if nvml_init() != 0:
    raise SystemExit(0)

get_count.argtypes = [ctypes.POINTER(ctypes.c_uint)]
get_count.restype = ctypes.c_int
get_handle.argtypes = [ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p)]
get_handle.restype = ctypes.c_int

class ClockOffset(ctypes.Structure):
    _fields_ = [
        ("version", ctypes.c_uint),
        ("type", ctypes.c_uint),
        ("pstate", ctypes.c_uint),
        ("clock_offset_mhz", ctypes.c_int),
        ("min_clock_offset_mhz", ctypes.c_int),
        ("max_clock_offset_mhz", ctypes.c_int),
    ]

get_clock_offsets = getattr(nvml, "nvmlDeviceGetClockOffsets", None)
if get_clock_offsets is not None:
    get_clock_offsets.argtypes = [ctypes.c_void_p, ctypes.POINTER(ClockOffset)]
    get_clock_offsets.restype = ctypes.c_int

get_core_offset = getattr(nvml, "nvmlDeviceGetGpcClkVfOffset", None)
get_memory_offset = getattr(nvml, "nvmlDeviceGetMemClkVfOffset", None)
if get_core_offset is not None:
    get_core_offset.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
    get_core_offset.restype = ctypes.c_int
if get_memory_offset is not None:
    get_memory_offset.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
    get_memory_offset.restype = ctypes.c_int

count = ctypes.c_uint()
if get_count(ctypes.byref(count)) != 0:
    nvml_shutdown()
    raise SystemExit(0)

def new_offset(handle, clock_type):
    if get_clock_offsets is None:
        return None
    first_value = None
    for pstate in range(16):
        info = ClockOffset(ctypes.sizeof(ClockOffset) | (1 << 24), clock_type, pstate, 0, 0, 0)
        if get_clock_offsets(handle, ctypes.byref(info)) == 0:
            if first_value is None:
                first_value = info.clock_offset_mhz
            if info.clock_offset_mhz != 0:
                return info.clock_offset_mhz
    return first_value

for index in range(count.value):
    handle = ctypes.c_void_p()
    if get_handle(index, ctypes.byref(handle)) != 0:
        continue

    core = new_offset(handle, 0)
    memory = new_offset(handle, 2)

    if core is None and get_core_offset is not None:
        value = ctypes.c_int()
        if get_core_offset(handle, ctypes.byref(value)) == 0:
            core = value.value
    if memory is None and get_memory_offset is not None:
        value = ctypes.c_int()
        if get_memory_offset(handle, ctypes.byref(value)) == 0:
            memory = value.value

    print(index, core if core is not None else "N/A", memory if memory is not None else "N/A", sep="\t")

nvml_shutdown()
PY
    )
}

query_settings_value() {
    local settings_gpu=$1 attribute=$2 value

    value=$(nvidia-settings -q "[gpu:${settings_gpu}]/${attribute}" -t 2>/dev/null \
        | awk 'NF { gsub(/[[:space:]]/, ""); print; exit }')
    if [[ $value =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
        printf '%s' "$value"
        return 0
    fi
    return 1
}

query_offset() {
    local settings_gpu=$1 attribute=$2
    local level value first_value=''
    local query_args=()

    # nvidia-settings can expose a value only for a particular performance
    # level (for example, GPUGraphicsClockOffset[3]). Prefer a non-zero
    # configured level so those offsets do not get hidden by an unindexed 0.
    for level in $(seq 0 15); do
        query_args+=(-q "[gpu:${settings_gpu}]/${attribute}[${level}]")
    done
    while IFS= read -r value; do
        value=$(trim "$value")
        [[ $value =~ ^-?[0-9]+([.][0-9]+)?$ ]] || continue
        [[ -z $first_value ]] && first_value=$value
        if awk -v n="$value" 'BEGIN { exit !(n != 0) }'; then
            printf '%s' "$value"
            return 0
        fi
    done < <(nvidia-settings "${query_args[@]}" -t 2>/dev/null)

    if value=$(query_settings_value "$settings_gpu" "$attribute"); then
        if awk -v n="$value" 'BEGIN { exit !(n != 0) }'; then
            printf '%s' "$value"
            return 0
        fi
        [[ -z $first_value ]] && first_value=$value
    fi

    if value=$(query_settings_value "$settings_gpu" "${attribute}AllPerformanceLevels"); then
        if awk -v n="$value" 'BEGIN { exit !(n != 0) }'; then
            printf '%s' "$value"
            return 0
        fi
        [[ -z $first_value ]] && first_value=$value
    fi

    if [[ -n $first_value ]]; then
        printf '%s' "$first_value"
        return 0
    fi
    printf 'N/A'
}

overclock_offsets_for_bus() {
    local bus_decimal=$1
    local settings_gpu=''
    local core_offset memory_offset

    if [[ -n $bus_decimal ]]; then
        settings_gpu=${settings_gpu_by_bus[$bus_decimal]-}
    fi

    if [[ -z $settings_gpu ]] || ! command -v nvidia-settings >/dev/null 2>&1; then
        printf 'N/A\tN/A\n'
        return
    fi

    core_offset=$(query_offset "$settings_gpu" GPUGraphicsClockOffset)
    memory_offset=$(query_offset "$settings_gpu" GPUMemoryTransferRateOffset)
    printf '%s\t%s\n' "$core_offset" "$memory_offset"
}

clock_value_from_string() {
    local value_string=$1 key=$2 value

    if [[ ,$value_string, =~ ,[[:space:]]*${key}=([^,[:space:]]+) ]]; then
        value=${BASH_REMATCH[1]}
        if is_number "$value"; then
            printf '%s' "$value"
            return 0
        fi
    fi
    return 1
}

clocks_for_bus() {
    local bus_decimal=$1
    local settings_gpu='' clock_string
    local current_graphics max_graphics current_memory max_memory

    if [[ -n $bus_decimal ]]; then
        settings_gpu=${settings_gpu_by_bus[$bus_decimal]-}
    fi
    if [[ -z $settings_gpu ]] || ! command -v nvidia-settings >/dev/null 2>&1; then
        printf 'N/A\tN/A\tN/A\tN/A\n'
        return
    fi

    clock_string=$(nvidia-settings -q "[gpu:${settings_gpu}]/GPUCurrentClockFreqsString" -t 2>/dev/null \
        | awk 'NF { print; exit }')
    current_graphics=$(clock_value_from_string "$clock_string" nvclock || printf 'N/A')
    max_graphics=$(clock_value_from_string "$clock_string" nvclockmax || printf 'N/A')
    current_memory=$(clock_value_from_string "$clock_string" memclock || printf 'N/A')
    max_memory=$(clock_value_from_string "$clock_string" memclockmax || printf 'N/A')
    printf '%s\t%s\t%s\t%s\n' "$current_graphics" "$max_graphics" "$current_memory" "$max_memory"
}

discover_settings_gpus() {
    local settings_gpu bus bus_decimal
    settings_gpu_by_bus=()

    if ! command -v nvidia-settings >/dev/null 2>&1; then
        return
    fi

    # nvidia-settings GPU indices do not necessarily match nvidia-smi indices.
    # Match them through the PCI bus number instead.
    for settings_gpu in $(seq 0 31); do
        bus=$(nvidia-settings -q "[gpu:${settings_gpu}]/PCIBus" -t 2>/dev/null | head -n 1 | tr -d '[:space:]')
        if [[ $bus =~ ^0[xX]([0-9A-Fa-f]+)$ ]]; then
            bus_decimal=$((16#${BASH_REMATCH[1]}))
        elif [[ $bus =~ ^[0-9]+$ ]]; then
            bus_decimal=$bus
        else
            [[ $settings_gpu -gt 0 ]] && break
            continue
        fi
        settings_gpu_by_bus[$bus_decimal]=$settings_gpu
    done
}

render_snapshot() {
    local rows
    local index name pci_bus_id gpu_temp memory_temp power_draw power_limit
    local memory_used memory_total gpu_util memory_util current_graphics max_graphics
    local current_memory max_memory fan pstate
    local bus_hex bus_decimal offsets clock_values core_offset memory_offset memory_pct
    local settings_current_graphics settings_max_graphics settings_current_memory settings_max_memory
    local rendered=0

    rows=$(nvidia-smi --query-gpu=index,name,pci.bus_id,temperature.gpu,temperature.memory,power.draw,power.limit,memory.used,memory.total,utilization.gpu,utilization.memory,clocks.current.graphics,clocks.max.graphics,clocks.current.memory,clocks.max.memory,fan.speed,pstate --format=csv,noheader,nounits 2>/dev/null) || {
        printf '%sUnable to read GPU data from nvidia-smi.%s\n' "$red" "$reset"
        return 1
    }

    if [[ -z $rows ]]; then
        printf '%sNo NVIDIA GPUs were reported by nvidia-smi.%s\n' "$red" "$reset"
        return 1
    fi

    nvml_offsets_for_gpus

    while IFS=',' read -r index name pci_bus_id gpu_temp memory_temp power_draw power_limit memory_used memory_total gpu_util memory_util current_graphics max_graphics current_memory max_memory fan pstate; do
        index=$(trim "$index")
        [[ -z $index ]] && continue
        if [[ -n $gpu_filter && $index != "$gpu_filter" ]]; then
            continue
        fi

        name=$(trim "$name")
        name=${name#NVIDIA }
        name=${name#GeForce }
        pci_bus_id=$(trim "$pci_bus_id")
        gpu_temp=$(trim "$gpu_temp")
        memory_temp=$(trim "$memory_temp")
        power_draw=$(trim "$power_draw")
        power_limit=$(trim "$power_limit")
        memory_used=$(trim "$memory_used")
        memory_total=$(trim "$memory_total")
        gpu_util=$(trim "$gpu_util")
        memory_util=$(trim "$memory_util")
        current_graphics=$(trim "$current_graphics")
        max_graphics=$(trim "$max_graphics")
        current_memory=$(trim "$current_memory")
        max_memory=$(trim "$max_memory")
        fan=$(trim "$fan")
        pstate=$(trim "$pstate")

        if [[ $pci_bus_id =~ :([0-9A-Fa-f]{2}): ]]; then
            bus_hex=${BASH_REMATCH[1]}
        elif [[ $pci_bus_id =~ ^([0-9A-Fa-f]{2}): ]]; then
            bus_hex=${BASH_REMATCH[1]}
        else
            bus_hex=''
        fi
        if [[ -n $bus_hex ]]; then
            bus_decimal=$((16#$bus_hex))
        else
            bus_decimal=''
        fi

        core_offset=${nvml_core_offsets[$index]-}
        memory_offset=${nvml_memory_offsets[$index]-}
        if [[ -z $core_offset || -z $memory_offset ]]; then
            offsets=$(overclock_offsets_for_bus "$bus_decimal")
            IFS=$'\t' read -r settings_core_offset settings_memory_offset <<< "$offsets"
            [[ -n $core_offset ]] || core_offset=$settings_core_offset
            [[ -n $memory_offset ]] || memory_offset=$settings_memory_offset
        fi
        [[ -n $core_offset ]] || core_offset='N/A'
        [[ -n $memory_offset ]] || memory_offset='N/A'
        clock_values=$(clocks_for_bus "$bus_decimal")
        IFS=$'\t' read -r settings_current_graphics settings_max_graphics settings_current_memory settings_max_memory <<< "$clock_values"
        [[ $settings_current_graphics != N/A ]] && current_graphics=$settings_current_graphics
        [[ $settings_max_graphics != N/A ]] && max_graphics=$settings_max_graphics
        [[ $settings_current_memory != N/A ]] && current_memory=$settings_current_memory
        [[ $settings_max_memory != N/A ]] && max_memory=$settings_max_memory
        memory_pct=$(memory_percent "$memory_used" "$memory_total")

        printf '%s%-12.12s%s |%s/%s |%s |%s | GCLK %s | M %s/%sGB%s | MEM %s | MCLK %s MHz | FAN %s | Core %4s | Mem %4s | %2s%s\n' \
            "$cyan" "$name" "$reset" \
            "$(temp_compact_field "$gpu_temp")" "$(temp_compact_field "$memory_temp" 85 95)" \
            "$(fmt_percent_field "$gpu_util")" "$(fmt_power_pair "$power_draw" "$power_limit")" \
            "$(fmt_clock_pair "$current_graphics" "$max_graphics")" \
            "$(fmt_gib_field "$memory_used")" "$(fmt_gib_field "$memory_total")" \
            "$(capacity_compact_field "$memory_pct")" "$(util_field "$memory_util")" \
            "$(fmt_clock_pair "$current_memory" "$max_memory")" \
            "$(fan_field "$fan")" "$(fmt_offset_short "$core_offset")" \
            "$(fmt_offset_short "$memory_offset")" "${pstate:-N/A}" "$reset"
        rendered=1
    done <<< "$rows"

    if (( rendered == 0 )); then
        printf '%sNo matching NVIDIA GPU was found.%s\n' "$red" "$reset"
        return 1
    fi
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -r|--refresh-rate|-i|--interval)
            [[ $# -ge 2 ]] || die "${1} requires a value."
            interval=$2
            shift 2
            ;;
        -g|--gpu)
            [[ $# -ge 2 ]] || die "${1} requires a GPU index."
            gpu_filter=$2
            shift 2
            ;;
        -1|--once)
            once=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [[ $positional_refresh_rate == 0 && $1 =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]]; then
                interval=$1
                positional_refresh_rate=1
                shift
            else
                die "Unknown option: $1 (try --help)."
            fi
            ;;
    esac
done

if [[ ! $interval =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || ! awk -v n="$interval" 'BEGIN { exit !(n > 0) }'; then
    die "Refresh rate must be a positive number, such as 1, 1.0, .5, or 2.3."
fi
if [[ -n $gpu_filter && ! $gpu_filter =~ ^[0-9]+$ ]]; then
    die "GPU index must be a non-negative integer."
fi
command -v nvidia-smi >/dev/null 2>&1 || die 'nvidia-smi is required.'

discover_settings_gpus

trap 'printf "%s%s" "$reset" "$show_cursor"; exit 0' INT TERM

while :; do
    # Collect everything before touching the terminal. Offset queries can take
    # noticeably longer than nvidia-smi, so clearing first would cause a blink.
    snapshot=$(render_snapshot)
    frame=$(printf '%sGPUWatch v%s%s  refresh %ss\n\n%s' \
        "$cyan" "$gpuwatch_version" "$reset" "$interval" "$snapshot")

    if [[ -t 1 ]]; then
        # Send the completed frame in one write. Clear each line in place and
        # clear only anything left below the new frame; do not blank the whole
        # terminal first, which is what causes visible flashing.
        drawn_frame=${frame//$'\n'/$'\n\033[2K'}
        printf '\033[H\033[?25l\033[2K%s\033[J%s' "$drawn_frame" "$show_cursor"
    else
        printf '%s\n' "$frame"
    fi

    (( once == 1 )) && break
    sleep "$interval"
done
