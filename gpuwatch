#!/usr/bin/env bash
# gpuwatch - live NVIDIA and AMD GPU settings and telemetry watcher.
#
# This intentionally focuses on the GPU itself: temperatures, power, memory,
# clocks, and driver-exposed overclock settings. It does not list processes.

set -u

LC_ALL=C
export LC_ALL

gpuwatch_version='2.06'
interval=1
gpu_filter=''
once=0
positional_refresh_rate=0
allow_sudo_prompt=1
original_args=("$@")
declare -A nvml_core_offsets=()
declare -A nvml_memory_offsets=()
hbm_mclk_bin=''
# Every new nvidia-smi / NVML session makes the CMP unlock driver log 18 lines (3 per GPU pair), so live mode keeps
# ONE nvidia-smi running (-lms) and reads its rows, and refreshes the NVML clock offsets only every offsets_every s.
smi_fields='index,name,pci.bus_id,pci.device_id,temperature.gpu,temperature.memory,power.draw,power.limit,memory.used,memory.total,utilization.gpu,utilization.memory,clocks.current.graphics,clocks.max.graphics,clocks.current.memory,clocks.max.memory,fan.speed,pstate'
offsets_every=30
offsets_at=''
stream_dir=''
smi_pid=''
reader_pid=''
stream_started_at=0
gpu_backend=''

if [[ -t 1 ]]; then
    cyan=$'\033[36m'
    green=$'\033[32m'
    yellow=$'\033[33m'
    red=$'\033[31m'
    dim=$'\033[2m'
    reset=$'\033[0m'
    show_cursor=$'\033[?25h'
else
    cyan=''
    green=''
    yellow=''
    red=''
    dim=''
    reset=''
    show_cursor=''
fi

usage() {
    cat <<EOF
Usage: ${0##*/} [REFRESH_RATE] [OPTIONS]

Live NVIDIA and AMD GPU settings and telemetry watcher.

Argument:
  REFRESH_RATE             Refresh rate in seconds (for example: 1, 1.0, .5)

Options:
  -r, --refresh-rate SEC   Refresh rate in seconds (default: 1)
  -i, --interval SEC       Alias for --refresh-rate
  -g, --gpu INDEX         Show only one GPU index
  -1, --once              Print one snapshot and exit
  --offsets-every SEC     Re-read the NVML clock offsets every SEC seconds (default: 30)
  --no-sudo               Never offer to re-run with sudo for HBM clocks
  -h, --help              Show this help

 Displayed values include GPU and memory temperature, power draw and limit,
 VRAM usage, utilization, current/max performance-level graphics and memory
 clocks, fan speed, P-state, and core/memory clock offsets when the driver
 exposes them. NVIDIA uses NVML/nvidia-settings; AMD uses amd-smi, with an
 amdgpu sysfs fallback. AMD offset fields are shown as N/A unless a compatible
 read-only driver value is available.

 On CMP 170HX (HBM), the driver refuses memory offsets and nvidia-smi memory
 clocks are blind to the live setting: the true HBM clock is NDIV*27 MHz,
 read via hbm_mclk over BAR0 (needs root). When available, MCLK shows the
 true clock with its NDIV (for example: 999 MHz [N37]); stock is N64=1728.
 Without root or hbm_mclk, MCLK falls back to the driver's (possibly stale)
 value. When run interactively on a 170HX box without root, gpuwatch
 automatically re-runs itself with sudo (--no-sudo disables this behavior).

 NVIDIA live mode reads one long-running nvidia-smi (-lms) instead of starting
 a new one every refresh: on the CMP unlock driver every new nvidia-smi or
 NVML session logs 18 kernel lines, which a once-a-second poll turned into
 gigabytes of syslog a day. AMD is polled through amd-smi or amdgpu sysfs.

Press Ctrl-C to exit live mode.
EOF
}

die() {
    printf '%s\n' "$*" >&2
    exit 2
}

trim() {
    local value=${1-}
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

is_number() {
    [[ ${1-} =~ ^[0-9]+([.][0-9]+)?$ ]]
}

gpu_display_name() {
    local name=${1-} device_id=${2-} memory_total=${3-}
    local normalized_device_id=${device_id,,}
    normalized_device_id=${normalized_device_id#0x}

    # NVIDIA's driver reports CMP 170HX boards as "NVIDIA Graphics Device",
    # but the PCI device ID identifies GA100/CMP 170HX unambiguously.
    if [[ $normalized_device_id == 20c2* ]]; then
        if [[ $memory_total =~ ^[0-9]+$ ]] && (( memory_total >= 60000 )); then
            printf 'CMP 170HX 64G'
        else
            printf 'CMP 170HX'
        fi
        return
    fi

    name=${name#NVIDIA }
    name=${name#GeForce }
    printf '%s' "$name"
}

is_170hx() {
    local normalized_device_id=${1-}
    normalized_device_id=${normalized_device_id,,}
    normalized_device_id=${normalized_device_id#0x}
    [[ $normalized_device_id == 20c2* || $normalized_device_id == 2082* ]]
}

discover_hbm_tool() {
    hbm_mclk_bin=''
    if command -v hbm_mclk >/dev/null 2>&1; then
        hbm_mclk_bin=$(command -v hbm_mclk)
    elif [[ -x /usr/local/bin/hbm_mclk ]]; then
        hbm_mclk_bin=/usr/local/bin/hbm_mclk
    fi
}

# True HBM clock on CMP 170HX via BAR0 (hbm_mclk). nvidia-smi is blind to a
# live userspace NDIV write, so without this the MCLK column goes stale.
# Prints "NDIV\tMHZ" (for example: "37\t999") or nothing when unavailable.
# Needs root for BAR0 mmap; fails silently otherwise (caller falls back).
ndiv_for_gpu() {
    local smi_index=${1-} pci_bus_id=${2-}
    local out ndiv domain rest dom4 bdf

    [[ -n $hbm_mclk_bin && -x $hbm_mclk_bin ]] || return 1

    # Prefer addressing by BDF (unambiguous physical device). nvidia-smi bus
    # IDs look like 00000000:01:00.0; sysfs wants 0000:01:00.0 lowercase.
    if [[ $pci_bus_id =~ ^([0-9A-Fa-f]+):([0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}\.[0-9])$ ]]; then
        domain=${BASH_REMATCH[1]}
        rest=${BASH_REMATCH[2]}
        if dom4=$(printf '%04x' "$((16#$domain))" 2>/dev/null); then
            bdf=$(printf '%s:%s' "$dom4" "$rest" | tr 'A-F' 'a-f')
            out=$("$hbm_mclk_bin" -b "$bdf" get 2>/dev/null | grep -oE 'NDIV [0-9]+' | grep -oE '[0-9]+' | head -n 1)
            if [[ $out =~ ^[0-9]+$ ]]; then
                printf '%s\t%s\n' "$out" "$((out * 27))"
                return 0
            fi
        fi
    fi

    # Fallback: positional index (hbm_mclk sorts by BDF, same as nvidia-smi).
    if [[ $smi_index =~ ^[0-9]+$ ]]; then
        out=$("$hbm_mclk_bin" -g "$smi_index" get 2>/dev/null | grep -oE 'NDIV [0-9]+' | grep -oE '[0-9]+' | head -n 1)
        if [[ $out =~ ^[0-9]+$ ]]; then
            printf '%s\t%s\n' "$out" "$((out * 27))"
            return 0
        fi
    fi
    return 1
}

# MCLK field with the live NDIV: "  999 MHz [N37]". Same visual slot as the
# legacy current/max pair so 170HX rows stay aligned with each other.
fmt_ndiv_mclk() {
    local true_mhz=${1-} ndiv=${2-}
    if [[ $true_mhz =~ ^[0-9]+$ && $ndiv =~ ^[0-9]+$ ]]; then
        printf '%5s MHz [N%s]' "$true_mhz" "$ndiv"
    else
        printf '%s' "${true_mhz:-N/A}"
    fi
}

# Re-run under sudo when true HBM clocks need it. Only fires when every one of
# these holds: non-root, prompting allowed and interactive,
# sudo exists, hbm_mclk exists, a 170HX is present, and its NDIV is not
# already readable (a udev rule or setuid could allow BAR0 without root).
# Called once before the first frame; scripts/pipes never get prompted.
maybe_escalate_for_hbm() {
    local rows idx bus did norm ndiv_values
    (( EUID == 0 )) && return 0
    (( allow_sudo_prompt )) || return 0
    [[ -t 0 ]] || return 0
    command -v sudo >/dev/null 2>&1 || return 0
    [[ -n $hbm_mclk_bin && -x $hbm_mclk_bin ]] || return 0

    rows=$(nvidia-smi --query-gpu=index,pci.bus_id,pci.device_id --format=csv,noheader,nounits 2>/dev/null) || return 0
    idx=''; bus=''
    while IFS=',' read -r idx bus did; do
        idx=$(trim "$idx"); bus=$(trim "$bus"); did=$(trim "$did")
        norm=${did,,}; norm=${norm#0x}
        if [[ $norm == 20c2* || $norm == 2082* ]]; then
            break
        fi
        idx=''
    done <<< "$rows"
    [[ -n $idx ]] || return 0

    # Already readable without root? Then no escalation needed.
    if ndiv_values=$(ndiv_for_gpu "$idx" "$bus"); then
        [[ -n $ndiv_values ]] && return 0
    fi

    printf '%s170HX detected: re-running with sudo for true HBM MCLK/NDIV readings.%s\n' "$yellow" "$reset" >&2
    exec sudo -- "$0" "${original_args[@]}"
}

fmt_mem() {
    local value=${1-}
    if ! is_number "$value"; then
        printf '%s' "${value:-N/A}"
        return
    fi
    awk -v m="$value" 'BEGIN {
        if (m >= 1024 * 1024) printf "%.2f TiB", m / (1024 * 1024)
        else if (m >= 1024) printf "%.2f GiB", m / 1024
        else printf "%.0f MiB", m
    }'
}

fmt_watts() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.2f W' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_mhz() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.0f MHz' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_offset() {
    local value=${1-}
    if ! is_number "$value" && [[ ! $value =~ ^-[0-9]+([.][0-9]+)?$ ]]; then
        printf '%s' "${value:-N/A}"
    elif [[ $value == -* ]]; then
        printf '%s MHz' "$value"
    else
        printf '+%s MHz' "$value"
    fi
}

fmt_temp() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.0f°C' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_percent() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.0f%%' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_integer() {
    local value=${1-}
    if is_number "$value"; then
        printf '%.0f' "$value"
    else
        printf '%s' "${value:-N/A}"
    fi
}

fmt_offset_short() {
    local value=${1-}
    if ! is_number "$value" && [[ ! $value =~ ^-[0-9]+([.][0-9]+)?$ ]]; then
        printf '%s' "${value:-N/A}"
    elif [[ $value == -* ]]; then
        printf '%s' "$value"
    else
        printf '+%s' "$value"
    fi
}

fmt_temp_field() {
    local value=${1-}
    if is_number "$value"; then
        printf '%3.0f°C' "$value"
    else
        printf '%4s' "${value:-N/A}"
    fi
}

fmt_temp_compact() {
    local value=${1-}
    if is_number "$value"; then
        printf '%3.0fc' "$value"
    else
        printf '%4s' "${value:-N/A}"
    fi
}

temp_field() {
    local value=${1-}
    local field
    field=$(fmt_temp_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v t="$value" 'BEGIN { exit !(t > 82) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v t="$value" 'BEGIN { exit !(t > 75) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

memory_temp_field() {
    local value=${1-}
    local field
    field=$(fmt_temp_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v t="$value" 'BEGIN { exit !(t > 95) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v t="$value" 'BEGIN { exit !(t > 85) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

temp_compact_field() {
    local value=${1-}
    local warning=${2-75} critical=${3-82}
    local field
    field=$(fmt_temp_compact "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v t="$value" -v limit="$critical" 'BEGIN { exit !(t > limit) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v t="$value" -v limit="$warning" 'BEGIN { exit !(t > limit) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

fmt_percent_field() {
    local value=${1-}
    if is_number "$value"; then
        printf '%3.0f%%' "$value"
    else
        printf '%3s' "${value:-N/A}"
    fi
}

fan_field() {
    local value=${1-}
    local field
    field=$(fmt_percent_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v f="$value" 'BEGIN { exit !(f > 80) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

fmt_gib_field() {
    local value=${1-}
    if is_number "$value"; then
        awk -v m="$value" 'BEGIN { printf "%5.2f", m / 1024 }'
    else
        printf '%5s' "${value:-N/A}"
    fi
}

fmt_power_pair() {
    local draw=${1-} limit=${2-}
    local draw_field limit_field
    draw_field=$(fmt_integer "$draw")
    limit_field=$(fmt_integer "$limit")
    printf '%3s/%3sW' "$draw_field" "$limit_field"
}

fmt_clock_pair() {
    local current=${1-} maximum=${2-}
    # Reserve room for five-digit memory clocks such as 13801 on both clock
    # fields, keeping GCLK and MCLK columns aligned as frequencies change.
    printf '%5s/%5s' "$(fmt_integer "$current")" "$(fmt_integer "$maximum")"
}

util_field() {
    local value=${1-}
    local field
    field=$(fmt_percent_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

capacity_field() {
    local value=${1-}
    local field
    field=$(fmt_percent_field "$value")
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v u="$value" 'BEGIN { exit !(u >= 90) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v u="$value" 'BEGIN { exit !(u >= 70) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

capacity_compact_field() {
    local value=${1-}
    local field
    if is_number "$value"; then
        field=$(printf '%3.0f%%' "$value")
    else
        field=$(printf '%4s' "${value:-N/A}")
    fi
    if ! is_number "$value"; then
        printf '%s' "$field"
    elif awk -v u="$value" 'BEGIN { exit !(u >= 90) }'; then
        printf '%s%s%s' "$red" "$field" "$reset"
    elif awk -v u="$value" 'BEGIN { exit !(u >= 70) }'; then
        printf '%s%s%s' "$yellow" "$field" "$reset"
    else
        printf '%s%s%s' "$green" "$field" "$reset"
    fi
}

memory_percent() {
    local used=${1-} total=${2-}
    if is_number "$used" && is_number "$total" && [[ $total != 0 ]]; then
        awk -v u="$used" -v t="$total" 'BEGIN { printf "%.0f", (u / t) * 100 }'
    else
        printf 'N/A'
    fi
}

# AMD supplies equivalent read-only telemetry through amd-smi.  Its JSON
# schema has changed between releases, so the parser deliberately identifies
# fields by their documented names rather than pinning gpuwatch to one release.
# Rows use the same tab-separated schema as nvidia-smi above:
# index, name, BDF, device ID, temperatures, power, VRAM, utilization, clocks,
# fan, and performance level.  Values unavailable from the installed driver
# remain N/A instead of being guessed.
amd_smi_rows() {
    local metric static rows
    command -v amd-smi >/dev/null 2>&1 || return 1
    command -v python3 >/dev/null 2>&1 || return 1

    metric=$(amd-smi metric --json 2>/dev/null) || metric=''
    static=$(amd-smi static --json 2>/dev/null) || static=''
    [[ -n $metric || -n $static ]] || return 1

    rows=$(AMD_METRIC_JSON="$metric" AMD_STATIC_JSON="$static" python3 - <<'PY'
import json
import os
import re

def documents():
    for name in ("AMD_METRIC_JSON", "AMD_STATIC_JSON"):
        raw = os.environ.get(name, "")
        if not raw:
            continue
        try:
            yield json.loads(raw)
        except json.JSONDecodeError:
            continue

def is_device_key(key):
    return bool(re.search(r"(?:^|[^a-z])(gpu|card|device)[ _:#-]*[0-9a-f]+(?:$|[^a-z])", str(key).lower()))

def device_maps(value, parent=""):
    if not isinstance(value, dict):
        return
    for key, child in value.items():
        if isinstance(child, dict):
            # Current amd-smi emits GPU:0-style keys; some older releases use
            # a gpu map whose immediate children are numeric IDs.
            if is_device_key(key) or ("gpu" in str(key).lower() and any(isinstance(v, dict) for v in child.values())):
                if is_device_key(key):
                    yield str(key), child
                else:
                    for nested_key, nested in child.items():
                        if isinstance(nested, dict):
                            yield "GPU:" + str(nested_key), nested
            yield from device_maps(child, str(key))

def leaves(value, path=""):
    if isinstance(value, dict):
        for key, child in value.items():
            yield from leaves(child, (path + " " + str(key)).strip())
    elif isinstance(value, list):
        for child in value:
            yield from leaves(child, path)
    else:
        yield path.lower().replace("-", "_").replace(" ", "_"), value

def text(value):
    return str(value).strip() if value is not None else ""

def number(value, kind="plain"):
    raw = text(value)
    match = re.search(r"[-+]?[0-9]+(?:[.][0-9]+)?", raw)
    if not match:
        return "N/A"
    result = float(match.group(0))
    lower = raw.lower()
    if kind == "memory":
        if "tib" in lower or "tb" in lower:
            result *= 1024 * 1024
        elif "gib" in lower or "gb" in lower:
            result *= 1024
        elif "kib" in lower or "kb" in lower:
            result /= 1024
        elif "byte" in lower or result > 1048576:
            result /= 1024 * 1024
    elif kind == "power":
        if "uw" in lower or "microwatt" in lower:
            result /= 1000000
        elif "mw" in lower or "milliwatt" in lower:
            result /= 1000
    elif kind == "clock":
        if "ghz" in lower:
            result *= 1000
        elif "khz" in lower:
            result /= 1000
        elif "hz" in lower and "mhz" not in lower:
            result /= 1000000
    return ("%.3f" % result).rstrip("0").rstrip(".")

def select(flat, aliases, kind="plain"):
    for alias in aliases:
        for path, value in flat:
            if alias in path:
                parsed = number(value, kind)
                if parsed != "N/A":
                    return parsed
    return "N/A"

def select_text(flat, aliases):
    for alias in aliases:
        for path, value in flat:
            if alias in path and text(value):
                return text(value)
    return "N/A"

metric_devices = []
static_devices = []
for doc_index, doc in enumerate(documents()):
    target = metric_devices if doc_index == 0 and os.environ.get("AMD_METRIC_JSON") else static_devices
    seen = set()
    for key, device in device_maps(doc):
        marker = id(device)
        if marker not in seen:
            seen.add(marker)
            target.append((key, list(leaves(device))))

# A one-GPU system can have a top-level map without an explicit GPU label.
if not metric_devices and os.environ.get("AMD_METRIC_JSON"):
    try:
        metric_devices.append(("GPU:0", list(leaves(json.loads(os.environ["AMD_METRIC_JSON"])))) )
    except json.JSONDecodeError:
        pass

for index, (key, flat) in enumerate(metric_devices or static_devices):
    static_flat = static_devices[index][1] if index < len(static_devices) else []
    all_flat = flat + static_flat
    gpu_id = select_text(all_flat, ["gpu_id", "gpu_index"])
    if gpu_id == "N/A":
        match = re.search(r"([0-9]+)$", key)
        gpu_id = match.group(1) if match else str(index)
    name = select_text(all_flat, ["product_name", "market_name", "card_series", "asic_name", "name"])
    bdf = select_text(all_flat, ["bdf", "pci_bus", "bus_id"])
    device_id = select_text(all_flat, ["device_id", "pci_device"])
    edge = select(flat, ["temperature_edge", "edge_temperature", "temp_edge", "edge"], "plain")
    memory_temp = select(flat, ["temperature_mem", "mem_temperature", "temp_mem", "memory_temperature"], "plain")
    power = select(flat, ["average_socket_power", "current_socket_power", "power_draw", "power"], "power")
    power_limit = select(all_flat, ["power_cap", "power_limit", "max_power"], "power")
    memory_used = select(flat, ["vram_used", "memory_used", "used_vram", "used_memory"], "memory")
    memory_total = select(all_flat, ["vram_total", "memory_total", "total_vram", "total_memory"], "memory")
    gpu_util = select(flat, ["gfx_activity", "gpu_usage", "gpu_utilization", "gpu_activity"], "plain")
    memory_util = select(flat, ["mem_activity", "memory_usage", "memory_utilization"], "plain")
    gclk = select(flat, ["gfxclk", "gfx_0", "graphics_clock", "gpu_clock"], "clock")
    gclk_max = select(all_flat, ["max_gfxclk", "max_gpu_clock", "max_graphics_clock"], "clock")
    mclk = select(flat, ["uclk", "memclk", "memory_clock"], "clock")
    mclk_max = select(all_flat, ["max_uclk", "max_memclk", "max_memory_clock"], "clock")
    fan = select(flat, ["fan_speed_percent", "fan_percent", "fan_speed"], "plain")
    pstate = select_text(flat, ["performance_level", "pstate", "power_profile"])
    print("\t".join([gpu_id, name, bdf, device_id, edge, memory_temp, power, power_limit,
                     memory_used, memory_total, gpu_util, memory_util, gclk, gclk_max,
                     mclk, mclk_max, fan, pstate]))
PY
) || return 1
    [[ -n $rows ]] || return 1
    printf '%s\n' "$rows"
}

amd_sysfs_rows() {
    local device card index vendor name bdf hwmon base gpu_temp memory_temp power power_limit
    local memory_used memory_total gpu_util current_graphics max_graphics current_memory max_memory fan pstate

    for device in /sys/class/drm/card*/device; do
        [[ -r $device/vendor ]] || continue
        vendor=$(<"$device/vendor")
        [[ ${vendor,,} == 0x1002 ]] || continue
        card=${device%/device}; card=${card##*/}; index=${card#card}
        name=$(lspci -s "$(<"$device/uevent" 2>/dev/null | sed -n 's/^PCI_SLOT_NAME=//p')" 2>/dev/null | sed 's/^[^:]*: //')
        [[ -n $name ]] || name='AMD GPU'
        bdf=$(sed -n 's/^PCI_SLOT_NAME=//p' "$device/uevent" 2>/dev/null | head -n 1)
        hwmon=$(find "$device/hwmon" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n 1)
        base=${hwmon:-$device}
        gpu_temp=$(awk '{printf "%.3f", $1 / 1000}' "$base/temp1_input" 2>/dev/null || printf 'N/A')
        memory_temp=$(awk '{printf "%.3f", $1 / 1000}' "$base/temp2_input" 2>/dev/null || printf 'N/A')
        power=$(awk '{printf "%.3f", $1 / 1000000}' "$base/power1_average" 2>/dev/null || printf 'N/A')
        power_limit=$(awk '{printf "%.3f", $1 / 1000000}' "$base/power1_cap" 2>/dev/null || printf 'N/A')
        memory_used=$(awk '{printf "%.3f", $1 / 1024 / 1024}' "$device/mem_info_vram_used" 2>/dev/null || printf 'N/A')
        memory_total=$(awk '{printf "%.3f", $1 / 1024 / 1024}' "$device/mem_info_vram_total" 2>/dev/null || printf 'N/A')
        gpu_util=$(cat "$device/gpu_busy_percent" 2>/dev/null || printf 'N/A')
        current_graphics=$(awk '/\*/ {for (i = 1; i <= NF; i++) if ($i !~ /:$/ && $i ~ /[0-9]/) {v = $i; gsub(/[^0-9.]/, "", v); if (v != "") {print v; exit}}}' "$device/pp_dpm_sclk" 2>/dev/null || printf 'N/A')
        max_graphics=$(awk '{for (i = 1; i <= NF; i++) if ($i !~ /:$/ && $i ~ /[0-9]/) {v = $i; gsub(/[^0-9.]/, "", v); if (v != "") last = v}} END {if (last != "") print last}' "$device/pp_dpm_sclk" 2>/dev/null || printf 'N/A')
        current_memory=$(awk '/\*/ {for (i = 1; i <= NF; i++) if ($i !~ /:$/ && $i ~ /[0-9]/) {v = $i; gsub(/[^0-9.]/, "", v); if (v != "") {print v; exit}}}' "$device/pp_dpm_mclk" 2>/dev/null || printf 'N/A')
        max_memory=$(awk '{for (i = 1; i <= NF; i++) if ($i !~ /:$/ && $i ~ /[0-9]/) {v = $i; gsub(/[^0-9.]/, "", v); if (v != "") last = v}} END {if (last != "") print last}' "$device/pp_dpm_mclk" 2>/dev/null || printf 'N/A')
        fan=$(awk 'NR==FNR { max=$1; next } { if (max > 0) printf "%.3f", $1 * 100 / max }' "$base/fan1_max" "$base/fan1_input" 2>/dev/null || printf 'N/A')
        pstate=$(cat "$device/power_dpm_force_performance_level" 2>/dev/null || printf 'N/A')
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$index" "$name" "$bdf" 'N/A' "$gpu_temp" "$memory_temp" "$power" "$power_limit" \
            "$memory_used" "$memory_total" "$gpu_util" 'N/A' "$current_graphics" "$max_graphics" \
            "$current_memory" "$max_memory" "$fan" "$pstate"
    done
}

amd_rows() {
    amd_smi_rows || amd_sysfs_rows
}

has_amd_gpu() {
    local device vendor
    command -v amd-smi >/dev/null 2>&1 && return 0
    for device in /sys/class/drm/card*/device; do
        [[ -r $device/vendor ]] || continue
        vendor=$(<"$device/vendor")
        [[ ${vendor,,} == 0x1002 ]] && return 0
    done
    return 1
}

nvml_offsets_for_gpus() {
    nvml_core_offsets=()
    nvml_memory_offsets=()
    command -v python3 >/dev/null 2>&1 || return

    while IFS=$'\t' read -r index core_offset memory_offset; do
        [[ $index =~ ^[0-9]+$ ]] || continue
        [[ $core_offset =~ ^-?[0-9]+$ ]] && nvml_core_offsets[$index]=$core_offset
        [[ $memory_offset =~ ^-?[0-9]+$ ]] && nvml_memory_offsets[$index]=$memory_offset
    done < <(
        python3 - <<'PY' 2>/dev/null
import ctypes

try:
    nvml = ctypes.CDLL("libnvidia-ml.so.1")
    nvml_init = nvml.nvmlInit_v2
    nvml_shutdown = nvml.nvmlShutdown
    get_count = nvml.nvmlDeviceGetCount_v2
    get_handle = nvml.nvmlDeviceGetHandleByIndex_v2
except (AttributeError, OSError):
    raise SystemExit(0)

nvml_init.restype = ctypes.c_int
if nvml_init() != 0:
    raise SystemExit(0)

get_count.argtypes = [ctypes.POINTER(ctypes.c_uint)]
get_count.restype = ctypes.c_int
get_handle.argtypes = [ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p)]
get_handle.restype = ctypes.c_int

class ClockOffset(ctypes.Structure):
    _fields_ = [
        ("version", ctypes.c_uint),
        ("type", ctypes.c_uint),
        ("pstate", ctypes.c_uint),
        ("clock_offset_mhz", ctypes.c_int),
        ("min_clock_offset_mhz", ctypes.c_int),
        ("max_clock_offset_mhz", ctypes.c_int),
    ]

get_clock_offsets = getattr(nvml, "nvmlDeviceGetClockOffsets", None)
if get_clock_offsets is not None:
    get_clock_offsets.argtypes = [ctypes.c_void_p, ctypes.POINTER(ClockOffset)]
    get_clock_offsets.restype = ctypes.c_int

get_core_offset = getattr(nvml, "nvmlDeviceGetGpcClkVfOffset", None)
get_memory_offset = getattr(nvml, "nvmlDeviceGetMemClkVfOffset", None)
if get_core_offset is not None:
    get_core_offset.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
    get_core_offset.restype = ctypes.c_int
if get_memory_offset is not None:
    get_memory_offset.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
    get_memory_offset.restype = ctypes.c_int

count = ctypes.c_uint()
if get_count(ctypes.byref(count)) != 0:
    nvml_shutdown()
    raise SystemExit(0)

def new_offset(handle, clock_type):
    if get_clock_offsets is None:
        return None
    first_value = None
    for pstate in range(16):
        info = ClockOffset(ctypes.sizeof(ClockOffset) | (1 << 24), clock_type, pstate, 0, 0, 0)
        if get_clock_offsets(handle, ctypes.byref(info)) == 0:
            if first_value is None:
                first_value = info.clock_offset_mhz
            if info.clock_offset_mhz != 0:
                return info.clock_offset_mhz
    return first_value

for index in range(count.value):
    handle = ctypes.c_void_p()
    if get_handle(index, ctypes.byref(handle)) != 0:
        continue

    core = new_offset(handle, 0)
    memory = new_offset(handle, 2)

    if core is None and get_core_offset is not None:
        value = ctypes.c_int()
        if get_core_offset(handle, ctypes.byref(value)) == 0:
            core = value.value
    if memory is None and get_memory_offset is not None:
        value = ctypes.c_int()
        if get_memory_offset(handle, ctypes.byref(value)) == 0:
            memory = value.value

    print(index, core if core is not None else "N/A", memory if memory is not None else "N/A", sep="\t")

nvml_shutdown()
PY
    )
}

query_settings_value() {
    local settings_gpu=$1 attribute=$2 value

    value=$(nvidia-settings -q "[gpu:${settings_gpu}]/${attribute}" -t 2>/dev/null \
        | awk 'NF { gsub(/[[:space:]]/, ""); print; exit }')
    if [[ $value =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
        printf '%s' "$value"
        return 0
    fi
    return 1
}

query_offset() {
    local settings_gpu=$1 attribute=$2
    local level value first_value=''
    local query_args=()

    # nvidia-settings can expose a value only for a particular performance
    # level (for example, GPUGraphicsClockOffset[3]). Prefer a non-zero
    # configured level so those offsets do not get hidden by an unindexed 0.
    for level in $(seq 0 15); do
        query_args+=(-q "[gpu:${settings_gpu}]/${attribute}[${level}]")
    done
    while IFS= read -r value; do
        value=$(trim "$value")
        [[ $value =~ ^-?[0-9]+([.][0-9]+)?$ ]] || continue
        [[ -z $first_value ]] && first_value=$value
        if awk -v n="$value" 'BEGIN { exit !(n != 0) }'; then
            printf '%s' "$value"
            return 0
        fi
    done < <(nvidia-settings "${query_args[@]}" -t 2>/dev/null)

    if value=$(query_settings_value "$settings_gpu" "$attribute"); then
        if awk -v n="$value" 'BEGIN { exit !(n != 0) }'; then
            printf '%s' "$value"
            return 0
        fi
        [[ -z $first_value ]] && first_value=$value
    fi

    if value=$(query_settings_value "$settings_gpu" "${attribute}AllPerformanceLevels"); then
        if awk -v n="$value" 'BEGIN { exit !(n != 0) }'; then
            printf '%s' "$value"
            return 0
        fi
        [[ -z $first_value ]] && first_value=$value
    fi

    if [[ -n $first_value ]]; then
        printf '%s' "$first_value"
        return 0
    fi
    printf 'N/A'
}

overclock_offsets_for_bus() {
    local bus_decimal=$1
    local settings_gpu=''
    local core_offset memory_offset

    if [[ -n $bus_decimal ]]; then
        settings_gpu=${settings_gpu_by_bus[$bus_decimal]-}
    fi

    if [[ -z $settings_gpu ]] || ! command -v nvidia-settings >/dev/null 2>&1; then
        printf 'N/A\tN/A\n'
        return
    fi

    core_offset=$(query_offset "$settings_gpu" GPUGraphicsClockOffset)
    memory_offset=$(query_offset "$settings_gpu" GPUMemoryTransferRateOffset)
    printf '%s\t%s\n' "$core_offset" "$memory_offset"
}

clock_value_from_string() {
    local value_string=$1 key=$2 value

    if [[ ,$value_string, =~ ,[[:space:]]*${key}=([^,[:space:]]+) ]]; then
        value=${BASH_REMATCH[1]}
        if is_number "$value"; then
            printf '%s' "$value"
            return 0
        fi
    fi
    return 1
}

clocks_for_bus() {
    local bus_decimal=$1
    local settings_gpu='' clock_string
    local current_graphics max_graphics current_memory max_memory

    if [[ -n $bus_decimal ]]; then
        settings_gpu=${settings_gpu_by_bus[$bus_decimal]-}
    fi
    if [[ -z $settings_gpu ]] || ! command -v nvidia-settings >/dev/null 2>&1; then
        printf 'N/A\tN/A\tN/A\tN/A\n'
        return
    fi

    clock_string=$(nvidia-settings -q "[gpu:${settings_gpu}]/GPUCurrentClockFreqsString" -t 2>/dev/null \
        | awk 'NF { print; exit }')
    current_graphics=$(clock_value_from_string "$clock_string" nvclock || printf 'N/A')
    max_graphics=$(clock_value_from_string "$clock_string" nvclockmax || printf 'N/A')
    current_memory=$(clock_value_from_string "$clock_string" memclock || printf 'N/A')
    max_memory=$(clock_value_from_string "$clock_string" memclockmax || printf 'N/A')
    printf '%s\t%s\t%s\t%s\n' "$current_graphics" "$max_graphics" "$current_memory" "$max_memory"
}

discover_settings_gpus() {
    local settings_gpu bus bus_decimal
    settings_gpu_by_bus=()

    if ! command -v nvidia-settings >/dev/null 2>&1; then
        return
    fi

    # nvidia-settings GPU indices do not necessarily match nvidia-smi indices.
    # Match them through the PCI bus number instead.
    for settings_gpu in $(seq 0 31); do
        bus=$(nvidia-settings -q "[gpu:${settings_gpu}]/PCIBus" -t 2>/dev/null | head -n 1 | tr -d '[:space:]')
        if [[ $bus =~ ^0[xX]([0-9A-Fa-f]+)$ ]]; then
            bus_decimal=$((16#${BASH_REMATCH[1]}))
        elif [[ $bus =~ ^[0-9]+$ ]]; then
            bus_decimal=$bus
        else
            [[ $settings_gpu -gt 0 ]] && break
            continue
        fi
        settings_gpu_by_bus[$bus_decimal]=$settings_gpu
    done
}

# The live stream: one nvidia-smi -lms into a FIFO, and a reader that keeps only the newest complete set of rows in
# $stream_dir/rows (written to a temp file and renamed, so a frame never reads half a set).  A set ends when its
# row count reaches the GPU count, learned from the first set (the first index seen again).
start_stream() {
    local ms
    ms=$(awk -v s="$interval" 'BEGIN { m = int(s * 1000 + 0.5); if (m < 100) m = 100; print m }')
    if [[ -z $stream_dir ]]; then
        stream_dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/dev/shm}/gpuwatch.XXXXXX" 2>/dev/null) \
            || stream_dir=$(mktemp -d "${TMPDIR:-/tmp}/gpuwatch.XXXXXX") || die 'Unable to create a temp directory.'
    fi
    rm -f "$stream_dir/fifo"
    mkfifo "$stream_dir/fifo" || die 'Unable to create the nvidia-smi FIFO.'
    nvidia-smi --query-gpu="$smi_fields" --format=csv,noheader,nounits -lms "$ms" > "$stream_dir/fifo" 2>/dev/null &
    smi_pid=$!
    (
        block=()
        count=0
        first=''
        while IFS= read -r line; do
            [[ -n ${line//[[:space:]]/} ]] || continue
            idx=$(trim "${line%%,*}")
            if (( count == 0 )) && [[ -n $first && $idx == "$first" ]]; then
                count=${#block[@]}
                printf '%s\n' "${block[@]}" > "$stream_dir/rows.tmp" && mv -f "$stream_dir/rows.tmp" "$stream_dir/rows"
                block=()
            fi
            [[ -n $first ]] || first=$idx
            block+=("$line")
            if (( count > 0 && ${#block[@]} >= count )); then
                printf '%s\n' "${block[@]}" > "$stream_dir/rows.tmp" && mv -f "$stream_dir/rows.tmp" "$stream_dir/rows"
                block=()
            fi
        done < "$stream_dir/fifo"
    ) &
    reader_pid=$!
    stream_started_at=$SECONDS
}

stop_stream() {
    [[ -n $smi_pid ]] && kill "$smi_pid" 2>/dev/null
    [[ -n $reader_pid ]] && kill "$reader_pid" 2>/dev/null
    wait 2>/dev/null
    smi_pid=''
    reader_pid=''
    [[ -n $stream_dir ]] && rm -rf "$stream_dir"
    stream_dir=''
}

# Restart a stream that died (a driver reset, say) - but at most every 10 s, so a nvidia-smi that cannot run does not
# turn back into one new session per refresh.
ensure_stream() {
    if [[ -n $smi_pid ]] && kill -0 "$smi_pid" 2>/dev/null; then
        return
    fi
    if [[ -n $smi_pid ]] && (( SECONDS - stream_started_at < 10 )); then
        return
    fi
    [[ -n $reader_pid ]] && kill "$reader_pid" 2>/dev/null
    start_stream
}

render_amd_snapshot() {
    local rows index name pci_bus_id pci_device_id gpu_temp memory_temp power_draw power_limit
    local memory_used memory_total gpu_util memory_util current_graphics max_graphics
    local current_memory max_memory fan pstate memory_pct rendered=0

    rows=$(amd_rows) || {
        printf '%sUnable to read AMD GPU data from amd-smi or amdgpu sysfs.%s\n' "$red" "$reset"
        return 1
    }
    [[ -n $rows ]] || {
        printf '%sNo AMD GPUs were reported by amd-smi or amdgpu sysfs.%s\n' "$red" "$reset"
        return 1
    }

    while IFS=$'\t' read -r index name pci_bus_id pci_device_id gpu_temp memory_temp power_draw power_limit memory_used memory_total gpu_util memory_util current_graphics max_graphics current_memory max_memory fan pstate; do
        index=$(trim "$index")
        [[ -z $index ]] && continue
        [[ -z $gpu_filter || $index == "$gpu_filter" ]] || continue
        name=$(trim "$name")
        [[ -n $name && $name != N/A ]] || name='AMD GPU'
        memory_pct=$(memory_percent "$memory_used" "$memory_total")
        printf '%s%-13.13s%s |%s/%s |%s |%s | GCLK %s | M %s/%sGB%s | MEM %s | MCLK %s MHz | FAN %s | Core %4s | Mem %4s | %2s%s\n' \
            "$cyan" "$name" "$reset" \
            "$(temp_compact_field "$gpu_temp")" "$(temp_compact_field "$memory_temp" 85 95)" \
            "$(fmt_percent_field "$gpu_util")" "$(fmt_power_pair "$power_draw" "$power_limit")" \
            "$(fmt_clock_pair "$current_graphics" "$max_graphics")" \
            "$(fmt_gib_field "$memory_used")" "$(fmt_gib_field "$memory_total")" \
            "$(capacity_compact_field "$memory_pct")" "$(util_field "$memory_util")" \
            "$(fmt_clock_pair "$current_memory" "$max_memory")" \
            "$(fan_field "$fan")" 'N/A' 'N/A' "${pstate:-N/A}" "$reset"
        rendered=1
    done <<< "$rows"

    if (( rendered == 0 )); then
        printf '%sNo matching AMD GPU was found.%s\n' "$red" "$reset"
        return 1
    fi
}

render_snapshot() {
    local rows
    local index name pci_bus_id gpu_temp memory_temp power_draw power_limit
    local memory_used memory_total gpu_util memory_util current_graphics max_graphics
    local current_memory max_memory fan pstate
    local bus_hex bus_decimal offsets clock_values core_offset memory_offset memory_pct
    local settings_current_graphics settings_max_graphics settings_current_memory settings_max_memory
    local ndiv_values ndiv true_mclk mclk_field
    local rendered=0

    [[ $gpu_backend == amd ]] && {
        render_amd_snapshot
        return
    }

    if (( once == 1 )); then
        rows=$(nvidia-smi --query-gpu="$smi_fields" --format=csv,noheader,nounits 2>/dev/null) || {
            printf '%sUnable to read GPU data from nvidia-smi.%s\n' "$red" "$reset"
            return 1
        }
    else
        if [[ ! -s $stream_dir/rows ]]; then
            if [[ -n $smi_pid ]] && kill -0 "$smi_pid" 2>/dev/null; then
                printf '%sWaiting for nvidia-smi ...%s\n' "$dim" "$reset"
            else
                printf '%sUnable to read GPU data from nvidia-smi (retrying every 10 s).%s\n' "$red" "$reset"
            fi
            return 1
        fi
        rows=$(<"$stream_dir/rows")
    fi

    if [[ -z $rows ]]; then
        printf '%sNo NVIDIA GPUs were reported by nvidia-smi.%s\n' "$red" "$reset"
        return 1
    fi

    while IFS=',' read -r index name pci_bus_id pci_device_id gpu_temp memory_temp power_draw power_limit memory_used memory_total gpu_util memory_util current_graphics max_graphics current_memory max_memory fan pstate; do
        index=$(trim "$index")
        [[ -z $index ]] && continue
        if [[ -n $gpu_filter && $index != "$gpu_filter" ]]; then
            continue
        fi

        name=$(trim "$name")
        pci_bus_id=$(trim "$pci_bus_id")
        pci_device_id=$(trim "$pci_device_id")
        gpu_temp=$(trim "$gpu_temp")
        memory_temp=$(trim "$memory_temp")
        power_draw=$(trim "$power_draw")
        power_limit=$(trim "$power_limit")
        memory_used=$(trim "$memory_used")
        memory_total=$(trim "$memory_total")
        gpu_util=$(trim "$gpu_util")
        memory_util=$(trim "$memory_util")
        current_graphics=$(trim "$current_graphics")
        max_graphics=$(trim "$max_graphics")
        current_memory=$(trim "$current_memory")
        max_memory=$(trim "$max_memory")
        fan=$(trim "$fan")
        pstate=$(trim "$pstate")
        name=$(gpu_display_name "$name" "$pci_device_id" "$memory_total")

        if [[ $pci_bus_id =~ :([0-9A-Fa-f]{2}): ]]; then
            bus_hex=${BASH_REMATCH[1]}
        elif [[ $pci_bus_id =~ ^([0-9A-Fa-f]{2}): ]]; then
            bus_hex=${BASH_REMATCH[1]}
        else
            bus_hex=''
        fi
        if [[ -n $bus_hex ]]; then
            bus_decimal=$((16#$bus_hex))
        else
            bus_decimal=''
        fi

        core_offset=${nvml_core_offsets[$index]-}
        memory_offset=${nvml_memory_offsets[$index]-}
        if [[ -z $core_offset || -z $memory_offset ]]; then
            offsets=$(overclock_offsets_for_bus "$bus_decimal")
            IFS=$'\t' read -r settings_core_offset settings_memory_offset <<< "$offsets"
            [[ -n $core_offset ]] || core_offset=$settings_core_offset
            [[ -n $memory_offset ]] || memory_offset=$settings_memory_offset
        fi
        [[ -n $core_offset ]] || core_offset='N/A'
        [[ -n $memory_offset ]] || memory_offset='N/A'
        clock_values=$(clocks_for_bus "$bus_decimal")
        IFS=$'\t' read -r settings_current_graphics settings_max_graphics settings_current_memory settings_max_memory <<< "$clock_values"
        [[ $settings_current_graphics != N/A ]] && current_graphics=$settings_current_graphics
        [[ $settings_max_graphics != N/A ]] && max_graphics=$settings_max_graphics
        [[ $settings_current_memory != N/A ]] && current_memory=$settings_current_memory
        [[ $settings_max_memory != N/A ]] && max_memory=$settings_max_memory
        memory_pct=$(memory_percent "$memory_used" "$memory_total")

        # CMP 170HX: nvidia-smi memory clocks are blind to a live NDIV write,
        # so prefer the BAR0 truth (NDIV*27 MHz) when hbm_mclk can read it.
        mclk_field="$(fmt_clock_pair "$current_memory" "$max_memory") MHz"
        if is_170hx "$pci_device_id"; then
            ndiv=''; true_mclk=''
            if ndiv_values=$(ndiv_for_gpu "$index" "$pci_bus_id"); then
                IFS=$'\t' read -r ndiv true_mclk <<< "$ndiv_values"
            fi
            if [[ $ndiv =~ ^[0-9]+$ && $true_mclk =~ ^[0-9]+$ ]]; then
                mclk_field=$(fmt_ndiv_mclk "$true_mclk" "$ndiv")
            fi
        fi

        printf '%s%-13.13s%s |%s/%s |%s |%s | GCLK %s | M %s/%sGB%s | MEM %s | MCLK %s | FAN %s | Core %4s | Mem %4s | %2s%s\n' \
            "$cyan" "$name" "$reset" \
            "$(temp_compact_field "$gpu_temp")" "$(temp_compact_field "$memory_temp" 85 95)" \
            "$(fmt_percent_field "$gpu_util")" "$(fmt_power_pair "$power_draw" "$power_limit")" \
            "$(fmt_clock_pair "$current_graphics" "$max_graphics")" \
            "$(fmt_gib_field "$memory_used")" "$(fmt_gib_field "$memory_total")" \
            "$(capacity_compact_field "$memory_pct")" "$(util_field "$memory_util")" \
            "$mclk_field" \
            "$(fan_field "$fan")" "$(fmt_offset_short "$core_offset")" \
            "$(fmt_offset_short "$memory_offset")" "${pstate:-N/A}" "$reset"
        rendered=1
    done <<< "$rows"

    if (( rendered == 0 )); then
        printf '%sNo matching NVIDIA GPU was found.%s\n' "$red" "$reset"
        return 1
    fi
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -r|--refresh-rate|-i|--interval)
            [[ $# -ge 2 ]] || die "${1} requires a value."
            interval=$2
            shift 2
            ;;
        -g|--gpu)
            [[ $# -ge 2 ]] || die "${1} requires a GPU index."
            gpu_filter=$2
            shift 2
            ;;
        -1|--once)
            once=1
            shift
            ;;
        --offsets-every)
            [[ $# -ge 2 ]] || die "${1} requires a value."
            offsets_every=$2
            shift 2
            ;;
        --no-sudo)
            allow_sudo_prompt=0
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            if [[ $positional_refresh_rate == 0 && $1 =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]]; then
                interval=$1
                positional_refresh_rate=1
                shift
            else
                die "Unknown option: $1 (try --help)."
            fi
            ;;
    esac
done

if [[ ! $interval =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || ! awk -v n="$interval" 'BEGIN { exit !(n > 0) }'; then
    die "Refresh rate must be a positive number, such as 1, 1.0, .5, or 2.3."
fi
if [[ -n $gpu_filter && ! $gpu_filter =~ ^[0-9]+$ ]]; then
    die "GPU index must be a non-negative integer."
fi
if [[ ! $offsets_every =~ ^[0-9]+$ ]] || (( offsets_every < 1 )); then
    die "--offsets-every must be a whole number of seconds, 1 or more."
fi
if command -v nvidia-smi >/dev/null 2>&1; then
    gpu_backend=nvidia
elif has_amd_gpu; then
    gpu_backend=amd
else
    die 'No supported GPU telemetry source found (need nvidia-smi, amd-smi, or an AMDGPU sysfs device).'
fi

if [[ $gpu_backend == nvidia ]]; then
    discover_settings_gpus
    discover_hbm_tool
    maybe_escalate_for_hbm
fi

trap 'stop_stream; printf "%s%s\n\n" "$reset" "$show_cursor"; exit 0' INT TERM
trap 'stop_stream' EXIT

if [[ $gpu_backend == nvidia && $once == 0 ]]; then
    start_stream
    # the first set of rows, so the first frame is not "waiting" (at most ~3 s)
    for _ in $(seq 1 30); do
        [[ -s $stream_dir/rows ]] && break
        sleep 0.1
    done
fi

while :; do
    [[ $gpu_backend == nvidia && $once == 0 ]] && ensure_stream
    # The clock offsets change only when an overclock is applied: re-read them every offsets_every seconds, not
    # every frame (each read is a new NVML session).
    if [[ $gpu_backend == nvidia ]] && { [[ -z $offsets_at ]] || (( SECONDS - offsets_at >= offsets_every )); }; then
        nvml_offsets_for_gpus
        offsets_at=$SECONDS
    fi
    # Collect everything before touching the terminal. Offset queries can take
    # noticeably longer than nvidia-smi, so clearing first would cause a blink.
    snapshot=$(render_snapshot)
    frame=$(printf '%sGPUWatch v%s%s  refresh %ss\n\n%s' \
        "$cyan" "$gpuwatch_version" "$reset" "$interval" "$snapshot")

    if [[ -t 1 ]]; then
        # Send the completed frame in one write. Clear each line in place and
        # clear only anything left below the new frame; do not blank the whole
        # terminal first, which is what causes visible flashing.
        drawn_frame=${frame//$'\n'/$'\n\033[2K'}
        printf '\033[H\033[?25l\033[2K%s\033[J%s' "$drawn_frame" "$show_cursor"
    else
        printf '%s\n' "$frame"
    fi

    (( once == 1 )) && break
    sleep "$interval"
done
